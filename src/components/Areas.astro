---
// Die drei Bereiche der Startseite (Runde 18): drei gleich breite Spalten.
// Oben die Tab-Leiste: drei Farbfelder mit dem Wort des Bereichs, leise die Zahlen „5 projects, 2024–2026,
// 35 images“ (aus projects.json) und einem Textlink zur Seite des Bereichs (/creative/ …, Text aus site.json).
// Darunter auf dem beigen Grund die zwei angepinnten Projekte (featured), je mit eigenem Label über dem Titel
// („The longest adventure yet“, projects.json → pin). Am Fuß „Show all 5 projects“ klappt die übrigen Projekte des
// Bereichs im selben Format auf (nochmal: „Show less“). Ohne JavaScript bleibt der Knopf weg; dann führt der
// Call to Action zu allen Projekten.
// Zugehörigkeit: feine senkrechte Linien setzen die Kanten der Tabs nach unten fort, eine waagerechte schließt ab.
// Die Zeilen (Tab, Projekt 1, Projekt 2, Rest) stehen über alle drei Spalten auf gleicher Höhe (Subgrid).
import FeatProject from './FeatProject.astro';
import { site, CATEGORIES, featuredProjects, byCategory, categoryLabel, categoryHref, has } from '../lib/content.js';
import { projectImages } from '../lib/images.js';

const number = (n: number) => n.toLocaleString('en-US');
const areas = CATEGORIES.map((c) => {
  const list = byCategory(c).filter((p) => has(p.title));
  const pinned = featuredProjects(c);
  const rest = list.filter((p) => !pinned.includes(p));
  const years = list.flatMap((p) => String(p.year ?? '').match(/\d{4}/g) ?? []).map(Number);
  const images = list.reduce((n, p) => n + projectImages(p).filter((im) => !im.placeholder).length, 0);
  // Aufzählung, für alle Bereiche gleich: Projekte, Jahre, Bilder
  const [from, to] = [Math.min(...years), Math.max(...years)];
  const facts = [
    `${number(list.length)} ${list.length === 1 ? 'project' : 'projects'}`,
    ...(years.length ? [from === to ? String(from) : `${from}–${to}`] : []),
    `${number(images)} ${images === 1 ? 'image' : 'images'}`,
  ].join(', ');
  const own = site.areas?.[c] ?? {};
  const label = categoryLabel(c);
  return { c, label, cta: has(own.cta) ? own.cta : `Explore ${label}`, facts, pinned, rest, count: list.length };
});
---
<section class="areas" id="work" aria-labelledby="work-title">
  <h2 class="sr-only" id="work-title">Work</h2>
  <div class="areas__grid">
    {areas.map((a) => (
      <section class:list={['area', `area--${a.c}`]} id={a.c} aria-labelledby={`${a.c}-word`}>
        <div class="area__tab">
          <h3 class="area__word" id={`${a.c}-word`}>{a.label}</h3>
          <p class="area__facts">{a.facts}</p>
          <a class="area__cta" href={categoryHref(a.c)}>{a.cta}<span class="area__arrow" aria-hidden="true">→</span></a>
        </div>
        {a.pinned.map((p, k) => <FeatProject project={p} pin={has(p.pin) ? p.pin : 'Pinned'} tilt={k} />)}
        <div class="area__more">
          {a.rest.length > 0 && (
            <>
              <div class="area__extra" id={`${a.c}-more`} hidden>
                {a.rest.map((p, k) => <FeatProject project={p} tilt={k} />)}
              </div>
              <button type="button" class="area__toggle" aria-expanded="false" aria-controls={`${a.c}-more`} data-more={`Show all ${a.count} projects`} hidden>
                <span data-label>Show all {a.count} projects</span><span class="area__arrow" aria-hidden="true">↓</span>
              </button>
            </>
          )}
        </div>
      </section>
    ))}
  </div>
</section>

<script>
  // „Show all“: klappt die übrigen Projekte eines Bereichs auf und wieder zu. Ohne JavaScript bleibt der Knopf versteckt.
  document.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((btn) => {
    const box = document.getElementById(btn.getAttribute('aria-controls') ?? '');
    const label = btn.querySelector<HTMLElement>('[data-label]');
    if (!box || !label) return;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      box.hidden = !open;
      label.textContent = open ? 'Show less' : btn.dataset.more ?? '';
    });
  });
</script>
