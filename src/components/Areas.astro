---
// Die drei Bereiche der Startseite (Runde 12): drei gleich breite Spalten.
// Oben die Tab-Leiste: drei Farbfelder mit dem Wort des Bereichs (Link zur Seite des Bereichs, /creative/ …).
// Darunter auf dem beigen Grund bis zu zwei Featured Projects: Titel, Art und Jahr, drei kleine, leicht gedrehte
// Bilder nebeneinander (Hover je Bild); ein Klick aufs Projekt führt zur Projektseite (/projects/<slug>/).
// Am Fuß jeder Spalte „All 5 projects →“ (Link zur Seite des Bereichs): zwei gezeigt, dahinter alle.
// Zugehörigkeit: feine senkrechte Linien setzen die Kanten der Tabs nach unten fort; jede Spalte hängt an ihrem Tab.
// Die Zeilen (Tab, Projekt 1, Projekt 2, Link) stehen über alle drei Spalten auf gleicher Höhe (Subgrid). Kein Skript.
import Img from './Img.astro';
import T from './T.astro';
import { CATEGORIES, featuredProjects, byCategory, categoryLabel, categoryHref, projectHref, has } from '../lib/content.js';
import { projectImages } from '../lib/images.js';

const areas = CATEGORIES.map((c) => ({
  c,
  label: categoryLabel(c),
  count: byCategory(c).filter((x) => has(x.title)).length,
  projects: featuredProjects(c).map((p) => ({
    p,
    meta: [p.kind, p.year].filter(has),
    images: projectImages(p).filter((im) => !im.placeholder).slice(0, 3),
  })),
}));
const allLabel = (n: number) => (n === 1 ? '1 project' : `All ${n} projects`);
// Leicht gedreht wie die Vorschau in v4 beim Hover über ein Projekt; beim Hover dreht jedes Bild in die Gegenrichtung.
// Zweites Projekt mit anderen Winkeln, damit die beiden Reihen nicht gleich aussehen.
const tilts = [
  [[-1.5, 1], [2, -0.5], [-1, 1.5]],
  [[1.2, -1], [-1.8, 0.6], [1, -1.4]],
];
---
<section class="areas" id="work" aria-labelledby="work-title">
  <h2 class="sr-only" id="work-title">Work</h2>
  <div class="areas__grid">
    {areas.map((a) => (
      <section class:list={['area', `area--${a.c}`]} id={a.c} aria-labelledby={`${a.c}-word`}>
        <h3 class="area__tab">
          <a class="area__link" href={categoryHref(a.c)}><span class="area__word" id={`${a.c}-word`}>{a.label}</span></a>
        </h3>
        {a.projects.map(({ p, meta, images }, k) => (
          <article class="feat" aria-labelledby={`${p.slug}-feat`}>
            <a class="feat__link" href={projectHref(p)}>
              <h4 class="feat__title" id={`${p.slug}-feat`}><T v={p.title} /></h4>
              {meta.length > 0 && <p class="feat__meta">{meta.map((m, i) => (<>{i > 0 && ', '}<T v={m} /></>))}</p>}
              {images.length > 0 && (
                <span class="feat__thumbs" aria-hidden="true">
                  {images.map((im, i) => (
                    <span class="feat__thumb" style={`--tilt:${tilts[k % 2][i][0]}deg;--tilt-to:${tilts[k % 2][i][1]}deg`}>
                      <Img meta={im.meta} alt="" sizes="(min-width: 960px) 10vw, 30vw" />
                    </span>
                  ))}
                </span>
              )}
            </a>
          </article>
        ))}
        <p class="area__all">
          <a href={categoryHref(a.c)}>{allLabel(a.count)}<span class="sr-only"> in {a.label}</span><span class="area__arrow" aria-hidden="true">→</span></a>
        </p>
      </section>
    ))}
  </div>
</section>
