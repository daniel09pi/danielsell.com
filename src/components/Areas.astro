---
// Die drei Bereiche der Startseite in einem Abschnitt: drei Farbspalten wie im Hero.
// Ausgangszustand: drei gleich breite Spalten. Jede zeigt oben den Hinweis "Featured project: …", ein Bild
// des Projekts mit Punkten und Pfeilen zum Blättern, unten Wort und Projektzahl.
// Klick auf das Wort oder das Bild: die Spalte wird breit (Bild links, Text rechts, Kreuz oben rechts),
// die anderen werden Streifen mit senkrechtem Wort. Kreuz, Klick auf den Streifen der offenen Spalte oder
// Escape: zurück zum Ausgangszustand. Die Slideshow ist in beiden Zuständen dieselbe (gleiches Bild).
// Ohne JavaScript sind alle drei offen und stehen untereinander; die Wort-Buttons sind dann deaktiviert.
// Es ist immer genau eins der beiden Wörter (waagerecht, senkrecht) sichtbar; das gibt dem Button seinen Namen.
import Feature from './Feature.astro';
import T from './T.astro';
import { CATEGORIES, featured, byCategory, categoryLabel, has } from '../lib/content.js';

const projectHref = (p: any) => `/projects/${p.slug}/`;
const areas = CATEGORIES.map((c) => {
  const project = featured(c);
  const all = byCategory(c).filter((x) => has(x.title));
  return {
    c,
    label: categoryLabel(c),
    project,
    count: all.length,
    also: all.filter((x) => x !== project).map((x) => ({ title: x.title, href: projectHref(x) })),
  };
}).filter((a) => a.project);
const countLabel = (n: number) => `${n} ${n === 1 ? 'project' : 'projects'}`;
---
<section class="areas" id="work" aria-labelledby="work-title">
  <h2 class="sr-only" id="work-title">Work</h2>
  <div class="areas__row" data-areas>
    {areas.map((a) => (
      <section class:list={['area', `area--${a.c}`]} id={a.c} data-area>
        <h3 class="area__head">
          <button type="button" class="area__toggle" id={`${a.c}-toggle`} aria-controls={`${a.c}-panel`} disabled>
            <span class="area__label area__label--h">
              <span class="area__word">{a.label}</span>
              <span class="area__count">{countLabel(a.count)}</span>
            </span>
            <span class="area__label area__label--v">
              <span class="area__word">{a.label}</span>
              <span class="area__count">{countLabel(a.count)}</span>
            </span>
          </button>
        </h3>
        <div class="area__panel" id={`${a.c}-panel`} role="region" aria-labelledby={`${a.c}-toggle`}>
          <div class="area__bar">
            <p class="area__note">Featured project<span class="area__note-name">: <T v={a.project.title} /></span></p>
            <button type="button" class="area__close" aria-controls={`${a.c}-panel`} aria-label={`Close ${a.label}`} hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <Feature
            project={a.project}
            variant="panel"
            headingLevel={4}
            pageHref={projectHref(a.project)}
            moreLink={a.count > 1 ? `/projects/#${a.c}` : undefined}
            also={a.also}
          />
        </div>
      </section>
    ))}
  </div>
</section>

<script>
  const row = document.querySelector<HTMLElement>('[data-areas]');
  if (row) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wide = window.matchMedia('(min-width: 60rem)');
    const parts = Array.from(row.querySelectorAll<HTMLElement>('[data-area]')).map((area) => ({
      area,
      toggle: area.querySelector<HTMLButtonElement>('.area__toggle')!,
      panel: area.querySelector<HTMLElement>('.area__panel')!,
      close: area.querySelector<HTMLButtonElement>('.area__close')!,
      stage: area.querySelector<HTMLElement>('.feature__stage'),
    }));
    let wanted: HTMLElement | null | undefined;   // zuletzt gewünschter Zustand (null = Ausgangszustand)
    let timer = 0;

    // target null = Ausgangszustand, alle drei gleich breit; sonst ist target die offene Spalte
    const apply = (target: HTMLElement | null) => {
      parts.forEach(({ area, toggle, panel, close }) => {
        const isOpen = area === target;
        area.classList.toggle('is-open', isOpen);
        toggle.setAttribute('aria-expanded', String(isOpen));
        // Nur auf breiten Bildschirmen werden die anderen Spalten zu Streifen; schmal bleiben sie sichtbar und bedienbar.
        panel.inert = wide.matches && target !== null && !isOpen;
        close.hidden = !isOpen;
      });
      row.classList.toggle('has-open', target !== null);
    };
    // Erst ausblenden, dann umbauen; der Inhalt springt nie sichtbar ins neue Layout.
    const show = (target: HTMLElement | null, instant = false) => {
      if (target === wanted) return;
      wanted = target;
      clearTimeout(timer);
      if (instant || reduce.matches || !wide.matches) {
        row.classList.remove('is-leaving');
        apply(target);
        return;
      }
      row.classList.add('is-leaving');
      timer = window.setTimeout(() => {
        apply(target);
        row.classList.remove('is-leaving');
      }, 180);
    };

    parts.forEach(({ area, toggle, close, stage }) => {
      toggle.disabled = false;
      // Doppelklick: nur der erste Klick zählt, sonst öffnet und schließt die Spalte in einem Zug.
      toggle.addEventListener('click', (e) => { if (e.detail <= 1) show(wanted === area ? null : area); });
      // preventScroll: der Streifen ist so hoch wie die Spalte, Fokus darauf würde die Seite verschieben.
      close.addEventListener('click', () => { show(null); toggle.focus({ preventScroll: true }); });
      // Klick aufs Bild öffnet die Spalte (Maus); per Tastatur öffnet das Wort.
      stage?.addEventListener('click', () => { if (wanted === null) show(area); });
    });
    // Escape schließt, egal wo der Fokus steht; zurück aufs Wort nur, wenn er in der offenen Spalte war.
    document.addEventListener('keydown', (e) => {
      const open = parts.find((p) => p.area === wanted);
      if (e.key !== 'Escape' || !open) return;
      const inside = open.area.contains(document.activeElement);
      show(null);
      if (inside) open.toggle.focus({ preventScroll: true });
    });
    wide.addEventListener('change', () => { if (wanted !== undefined) apply(wanted); });

    const fromHash = (hash: string) => parts.find((p) => `#${p.area.id}` === hash)?.area ?? null;
    window.addEventListener('hashchange', () => { const a = fromHash(location.hash); if (a) show(a); });
    // Gleicher Link zweimal hintereinander löst kein hashchange aus, deshalb auch beim Klick öffnen.
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      const a = link && fromHash(link.getAttribute('href') ?? '');
      if (a) show(a);
    });

    row.classList.add('is-enhanced');
    show(fromHash(location.hash), true);
  }
</script>
