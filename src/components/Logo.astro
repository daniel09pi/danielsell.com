---
// Logo aus brand/*.svg, unverändert in der Geometrie. Farbe über currentColor (CSS: color).
import loose from '../../brand/logo.svg?raw';
import knockout from '../../brand/logo-knockout.svg?raw';

interface Props { variant?: 'loose' | 'knockout'; class?: string; label?: string; uid?: string }
const { variant = 'loose', class: cls = '', label, uid = 'a' } = Astro.props;

let svg = (variant === 'knockout' ? knockout : loose)
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/ds-logo-knockout/g, `ds-logo-knockout-${uid}`);
svg = label
  ? svg.replace(/aria-label="[^"]*"/, `aria-label="${label}"`)
  : svg.replace(/ role="img"/, ' aria-hidden="true" focusable="false"').replace(/ aria-label="[^"]*"/, '');
svg = svg.replace('<svg ', `<svg class="logo logo--${variant} ${cls}" `);
---
<Fragment set:html={svg} />
