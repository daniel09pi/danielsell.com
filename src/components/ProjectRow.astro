---
// Ein Projekt als Zeile auf der Bereichsseite, mit feinen Linien wie „Currently“ auf der Startseite.
// Links (Label,) Titel, Art und Datum und der erste Absatz des Texts; rechts vier kleine, leicht gedrehte Bilder wie
// auf der Startseite (Hover je Bild). Titel, Text und Bilder sind ein Link zur Projektseite.
// label + mark wie bei FeatProject: „pinned“ mit Nadel (mark: 'pin') oder „new“ mit Punkt (mark: 'new').
import Img from './Img.astro';
import T from './T.astro';
import { has, projectHref, projectDate, formatDate, paragraphs } from '../lib/content.js';
import { projectImages } from '../lib/images.js';

interface Props { project: any; label?: string; mark?: 'pin' | 'new'; tilt?: number }
const { project: p, label, mark = 'pin', tilt = 0 } = Astro.props;
const date = projectDate(p);
const lead = paragraphs(p.text)[0];
const images = projectImages(p).filter((im) => !im.placeholder).slice(0, 4);
// Gleiche Winkel wie auf der Startseite, im Wechsel zwei Sätze, damit Zeilen untereinander nicht gleich aussehen
const tilts = [
  [[-1.5, 1], [2, -0.5], [-1, 1.5], [1.4, -0.8]],
  [[1.2, -1], [-1.8, 0.6], [1, -1.4], [-1.3, 0.9]],
][tilt % 2];
---
<article class="row" aria-labelledby={`${p.slug}-row`}>
  {label && (
    <p class:list={['feat__label', 'row__label', `feat__label--${mark}`]}>
      {mark === 'pin'
        ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3.5h6M10 3.5v5.5l-3 3.5h10l-3-3.5V3.5M12 12.5V21" /></svg>
        : <span class="feat__dot" aria-hidden="true"></span>}
      <T v={label} />
    </p>
  )}
  <a class="row__link" href={projectHref(p)}>
    <div class="row__text">
      <h2 class="feat__title row__title" id={`${p.slug}-row`}><T v={p.title} /></h2>
      <p class="feat__meta row__meta">{has(p.kind) && <T v={p.kind} />}{has(p.kind) && (date || has(p.year)) && ', '}{date ? <>{date.word} <time datetime={date.iso}>{formatDate(date.iso)}</time></> : has(p.year) && <T v={p.year} />}</p>
      {has(lead) && <p class="row__lead"><T v={lead} /></p>}
    </div>
    {images.length > 0 && (
      <div class="row__thumbs" aria-hidden="true">
        {images.map((im, i) => (
          <span class="feat__thumb" style={`--tilt:${tilts[i][0]}deg;--tilt-to:${tilts[i][1]}deg`}>
            <Img meta={im.meta} alt="" sizes="(min-width: 960px) 15vw, 45vw" />
          </span>
        ))}
      </div>
    )}
  </a>
</article>
