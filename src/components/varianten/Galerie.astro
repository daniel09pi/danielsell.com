---
// TESTSEITE /varianten/: Vollbild-Ansicht wie in v4. Alle Bilder eines Projekts groß untereinander, ungeschnitten.
// Öffnen: ein Element mit data-galerie="<slug>" anklicken; data-bild="<nr>" (ab 0) scrollt direkt zu diesem Bild.
// Schließen: ×, Escape (macht <dialog> selbst). Fokus bleibt im Dialog, solange er offen ist.
import Img from '../Img.astro';
import { CATEGORIES, featured, categoryLabel, has } from '../../lib/content.js';
import { projectImages } from '../../lib/images.js';

const projects = CATEGORIES.map((c) => featured(c)).filter(Boolean);
---
{projects.map((p) => (
  <dialog class="galerie" id={`galerie-${p.slug}`} aria-labelledby={`galerie-${p.slug}-titel`}>
    <header class="galerie__kopf">
      <p class="galerie__titel" id={`galerie-${p.slug}-titel`}>
        {p.title}
        <span class="galerie__meta">{[categoryLabel(p.category), p.kind, p.year].filter(has).join(' · ')}</span>
      </p>
      <button type="button" class="galerie__zu" aria-label="Close" data-zu>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>
    <div class="galerie__bilder">
      {projectImages(p).filter((im) => !im.placeholder).map((im, i) => (
        <figure data-nr={i}>
          <Img meta={im.meta} alt={im.alt} sizes="(min-width: 1100px) 1000px, 92vw" />
        </figure>
      ))}
    </div>
  </dialog>
))}

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-galerie]');
    if (opener) {
      const dialog = document.getElementById(`galerie-${opener.dataset.galerie}`) as HTMLDialogElement | null;
      if (!dialog) return;
      e.preventDefault();
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      const fig = dialog.querySelector<HTMLElement>(`[data-nr="${opener.dataset.bild ?? 0}"]`);
      const head = dialog.querySelector<HTMLElement>('.galerie__kopf');
      dialog.scrollTop = fig && Number(opener.dataset.bild ?? 0) > 0 ? fig.offsetTop - (head?.offsetHeight ?? 0) - 8 : 0;
      return;
    }
    if (target.closest('[data-zu]')) target.closest('dialog')?.close();
  });
  document.querySelectorAll('dialog.galerie').forEach((d) =>
    d.addEventListener('close', () => { document.documentElement.style.overflow = ''; }),
  );
</script>

<style>
  .galerie {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: var(--ink-deep); color: var(--ground);
    overflow-y: auto; overscroll-behavior: contain;
  }
  .galerie::backdrop { background: var(--ink-deep); }
  .galerie__kopf {
    position: sticky; top: 0; z-index: 1;
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1rem var(--margin); background: var(--ink-deep);
  }
  .galerie__titel { font-size: var(--step-lead); line-height: 1.2; }
  .galerie__meta { margin-left: 0.75rem; color: var(--line); font-size: var(--step-small); }
  .galerie__zu {
    flex: none; width: 2.75rem; height: 2.75rem; display: grid; place-items: center;
    border: 0; background: none; color: var(--ground); cursor: pointer;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .galerie__zu svg { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; }
  .galerie__zu:hover { background: var(--ground); color: var(--ink-deep); }
  .galerie__zu:focus-visible { outline-color: var(--lime); }
  .galerie__bilder { display: grid; justify-items: center; gap: 1rem; padding: 1rem var(--margin) 5rem; }
  .galerie__bilder figure { width: min(100%, 1000px); }
  .galerie__bilder :global(img) { width: 100%; height: auto; }
</style>
