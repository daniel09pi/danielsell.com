---
// TESTSEITE /varianten/: Variante A "Kontaktbogen".
// Drei Farbspalten wie bisher. Ausgangszustand: pro Spalte Titel (mit Hinweis "Featured project" in der Metazeile),
// darunter vier Bilder als 2x2-Raster und eine Zeile mit "View project" links und der Bildzahl rechts,
// unten Wort und Projektzahl. Offen: alle Bilder als Raster mit drei Spalten
// links, Text rechts, Kreuz oben rechts, die anderen Spalten als Streifen. Alle Vorschaubilder einheitlich 4:3.
// Ein Klick auf ein Bild öffnet die gemeinsame Vollbild-Ansicht (Galerie.astro) bei genau diesem Bild.
// Statisch: beide Zustände stehen untereinander.
import VariantKopf from './VariantKopf.astro';
import Img from '../Img.astro';
import { CATEGORIES, featured, byCategory, categoryLabel, has, isUrl, isExternal } from '../../lib/content.js';
import { projectImages } from '../../lib/images.js';

const cols = CATEGORIES.map((c) => {
  const p = featured(c);
  if (!p) return null;
  const count = byCategory(c).filter((x) => has(x.title)).length;
  // Gleiche Zählung wie in Galerie.astro: Platzhalter raus, dann durchnummerieren (data-bild).
  const images = projectImages(p).filter((im) => !im.placeholder);
  const meta = [p.kind, p.year].filter(has).join(', ');
  const links = (p.links ?? []).filter((l) => has(l?.label) && isUrl(l?.url));
  return { c, p, label: categoryLabel(c), count, images, meta, links, featuredHint: count > 1 };
}).filter(Boolean) as any[];

const countLabel = (n: number) => `${n} ${n === 1 ? 'project' : 'projects'}`;
const open = cols.find((x) => x.c === 'creative') ?? cols[0];
---
<VariantKopf
  buchstabe="A"
  name="Kontaktbogen"
  text="Drei Farbspalten mit je vier Bildern im 2×2-Raster; die geöffnete Spalte zeigt alle Bilder als Kontaktbogen neben dem Text. Alle Vorschaubilder sind einheitlich auf 4:3 zugeschnitten, damit das Raster ruhig bleibt, ungeschnitten zeigt sie ein Klick im Vollbild."
/>

<p class="v-zustand">Ausgangszustand</p>
<div class="va-row va-row--equal">
  {cols.map((x) => (
    <section class:list={['va-col', `va-col--${x.c}`]} aria-labelledby={`va-${x.c}-word`}>
      <h3 class="va-label">
        <button type="button" class="va-word" id={`va-${x.c}-word`} aria-expanded="false">{x.label}</button>
        {x.count > 1
          ? <a class="va-count" href={`/projects/#${x.c}`}>{countLabel(x.count)}</a>
          : <span class="va-count">{countLabel(x.count)}</span>}
      </h3>
      <div class="va-proj">
        <h4 class="va-title">{x.p.title}</h4>
        <p class="va-meta">{x.featuredHint && <>Featured project<span aria-hidden="true"> · </span><span class="sr-only">, </span></>}{x.meta}</p>
        <ul class="va-sheet va-sheet--four">
          {x.images.slice(0, 4).map((im: any, i: number) => (
            <li>
              <button type="button" class="va-shot" data-galerie={x.p.slug} data-bild={i} aria-label={`${x.p.title}: open image ${i + 1} of ${x.images.length} full screen`}>
                <Img meta={im.meta} alt="" sizes="(min-width: 960px) 15vw, 45vw" />
              </button>
            </li>
          ))}
        </ul>
        <p class="va-cap">
          <a class="va-primary" href={`/projects/${x.p.slug}/`}>
            View project<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
          </a>
          {x.images.length > 4 && (
            <button type="button" class="va-all" data-galerie={x.p.slug} data-bild="0">All {x.images.length} images</button>
          )}
        </p>
      </div>
    </section>
  ))}
</div>

<p class="v-zustand">Offen: {open.label}</p>
<div class="va-row va-row--open">
  {cols.map((x) => x === open ? (
    <section class:list={['va-col', `va-col--${x.c}`, 'va-col--open']} aria-labelledby={`va-${x.c}-word-o`}>
      <h3 class="va-label">
        <button type="button" class="va-word" id={`va-${x.c}-word-o`} aria-expanded="true">{x.label}</button>
        {x.count > 1
          ? <a class="va-count" href={`/projects/#${x.c}`}>{countLabel(x.count)}</a>
          : <span class="va-count">{countLabel(x.count)}</span>}
      </h3>
      <button type="button" class="va-close" aria-label={`Close ${x.label}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <div class="va-open">
        <ul class="va-sheet va-sheet--all">
          {x.images.map((im: any, i: number) => (
            <li>
              <button type="button" class="va-shot" data-galerie={x.p.slug} data-bild={i} aria-label={`${x.p.title}: open image ${i + 1} of ${x.images.length} full screen`}>
                <Img meta={im.meta} alt="" sizes="(min-width: 960px) 17vw, 30vw" />
              </button>
            </li>
          ))}
        </ul>
        <div class="va-text">
          <h4 class="va-title va-title--big">{x.p.title}</h4>
          <p class="va-meta">{x.featuredHint && <>Featured project<span aria-hidden="true"> · </span><span class="sr-only">, </span></>}{x.meta}</p>
          {has(x.p.text) && <p class="va-body">{x.p.text}</p>}
          <p class="va-actions">
            <a class="va-primary" href={`/projects/${x.p.slug}/`}>
              View project<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            </a>
            {x.links.map((l: any) => (
              <a class="va-quiet" href={l.url} {...(isExternal(l.url) ? { rel: 'noopener', target: '_blank' } : {})}>
                {l.label}{isExternal(l.url) && <><span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></>}
              </a>
            ))}
          </p>
        </div>
      </div>
    </section>
  ) : (
    <section class:list={['va-col', `va-col--${x.c}`, 'va-col--strip']} aria-labelledby={`va-${x.c}-word-s`}>
      <h3 class="va-strip">
        <button type="button" class="va-strip__btn" id={`va-${x.c}-word-s`} aria-expanded="false">
          <span class="va-word">{x.label}</span>
          <span class="va-count">{countLabel(x.count)}</span>
        </button>
      </h3>
    </section>
  ))}
</div>

<style>
  /* Spalten und Farben: wie bisher, Text pro Fläche in ihrer Schriftfarbe */
  .va-row {
    --strip: clamp(4.5rem, 6.5vw, 6.5rem);
    --gap: 0.5rem;
    /* Höhe beider Zustände gleich und knapp über dem Inhalt: kein leerer Streifen zwischen Raster und Wort */
    --h: clamp(38rem, 80svh, 50rem);
    display: flex;
    min-height: var(--h);
  }
  .va-col { position: relative; min-width: 0; background: var(--bg); color: var(--fg); }
  .va-col--creative { --bg: var(--field-creative); --fg: var(--ink); --soft: var(--ink-soft); }
  .va-col--adventure { --bg: var(--field-adventure); --fg: var(--ground); --soft: var(--line); }
  .va-col--dev { --bg: var(--field-dev); --fg: var(--ink-deep); --soft: var(--ink-deep); }
  .va-col :focus-visible { outline-color: var(--fg); }

  /* Ausgangszustand: Projekt oben (Titel, Meta, 2x2), Wort und Zahl unten */
  .va-row--equal .va-col { flex: 1 1 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; }
  .va-proj { grid-row: 1; grid-column: 1; padding: clamp(2rem, 5vh, 3rem) var(--margin) 2rem; }
  .va-label { grid-row: 2; grid-column: 1; }

  /* Wort + Projektzahl (Zahl verlinkt auf alle Projekte des Bereichs) */
  .va-label { display: flex; align-items: baseline; gap: 0.75rem; padding: 1.25rem var(--margin) 1.75rem; font: inherit; }
  .va-word {
    padding: 0; border: 0; background: none; cursor: pointer; text-align: left;
    font-size: var(--step-head); line-height: 0.95; letter-spacing: -0.035em; font-weight: 450;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 0.04em; text-underline-offset: 0.14em;
    transition: text-decoration-color 0.25s var(--ease);
  }
  .va-word:hover { text-decoration-color: currentColor; }
  .va-count { color: var(--soft); font-size: var(--step-small); }
  a.va-count { text-decoration-color: color-mix(in srgb, currentColor 45%, transparent); }
  a.va-count:hover { color: var(--fg); text-decoration-color: currentColor; }

  /* Titel und Meta direkt beieinander; der Hinweis "Featured project" steht in der Metazeile */
  .va-title { font-size: clamp(1.5rem, 1.1rem + 0.9vw, 2rem); line-height: 1.1; font-weight: 450; letter-spacing: -0.02em; }
  /* Feste Zeilenhöhe, damit das Raster in allen Spalten gleich hoch beginnt. In dev gibt es keine hellere Schriftfarbe;
     dort trägt allein der Größenabstand Titel (ca. 30 px) zu Meta (16 px) die Rangfolge, gleiche Größe in allen Spalten. */
  .va-meta { margin-top: 0.35rem; color: var(--soft); font-size: 1rem; line-height: 1.4rem; }

  /* Kontaktbogen: gleich große 4:3-Felder, kleine Abstände */
  .va-sheet { display: grid; gap: var(--gap); }
  .va-sheet--four { margin-top: 1.25rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .va-sheet--all { grid-template-columns: repeat(3, minmax(0, 1fr)); align-self: start; }
  .va-shot {
    display: block; width: 100%; aspect-ratio: 4 / 3;
    padding: 0; border: 0; background: none; cursor: zoom-in;
    outline: 2px solid transparent; outline-offset: 3px;
    transition: outline-color 0.2s var(--ease);
  }
  /* Hover: nur ein Rahmen in der Schriftfarbe, nichts bewegt sich */
  .va-shot:hover, .va-shot:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  /* Bildunterschrift des Rasters: links der eine Hauptlink, rechts leise die Bildzahl (öffnet das Vollbild) */
  .va-cap { margin-top: 0.75rem; display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .va-all {
    padding: 0.4rem 0; border: 0; background: none; cursor: zoom-in;
    color: var(--soft); font-size: var(--step-small);
    text-decoration: underline; text-decoration-thickness: 0.07em; text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    transition: color 0.2s var(--ease), text-decoration-color 0.2s var(--ease);
  }
  .va-all:hover { color: var(--fg); text-decoration-color: currentColor; }
  .va-shot :global(picture) { display: block; width: 100%; height: 100%; }
  .va-shot :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* Offen: Raster links, Text rechts, Kreuz oben rechts; Wort und Zahl bleiben unten links */
  .va-row--open .va-col--open { flex: 1 1 auto; display: grid; grid-template-rows: minmax(0, 1fr) auto; }
  .va-row--open .va-col--strip { flex: 0 0 var(--strip); }
  .va-open {
    grid-row: 1; grid-column: 1;
    /* Rasterbreite: gut die Hälfte, höchstens 52 rem, und nie so hoch, dass das Wort unten gedrängt wird */
    display: grid; grid-template-columns: minmax(0, min(58%, 52rem, calc((var(--h) - 13rem) * 4 / 3))) minmax(0, 1fr);
    column-gap: clamp(2.5rem, 4.5vw, 5rem); align-items: start;
    padding: clamp(2rem, 5vh, 3rem) var(--margin) 2rem;
  }
  .va-text { padding-right: 3rem; }
  .va-title--big { font-size: clamp(2rem, 1.2rem + 1.6vw, 2.75rem); line-height: 1.05; letter-spacing: -0.025em; margin-top: -0.1em; }
  .va-text .va-meta { margin-top: 0.5rem; }
  .va-body { margin-top: 1.5rem; max-width: 36ch; }
  .va-actions { margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1.5rem; }
  .va-primary {
    display: inline-flex; align-items: center; gap: 0.45em; min-height: 2.75rem;
    font-size: var(--step-body); font-weight: 500; text-underline-offset: 0.25em;
  }
  .va-primary svg { flex: none; width: 0.9em; height: 0.9em; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: square; }
  .va-quiet { color: var(--soft); font-size: var(--step-small); }
  .va-quiet:hover { color: var(--fg); }

  .va-close {
    position: absolute; z-index: 1;
    top: calc(clamp(2rem, 5vh, 3rem) - 0.625rem); right: calc(var(--margin) - 0.625rem);
    width: 2.75rem; height: 2.75rem; display: grid; place-items: center;
    padding: 0; border: 0; background: none; color: inherit; cursor: pointer;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .va-close svg { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; }
  .va-close:hover { background: var(--fg); color: var(--bg); }

  /* Streifen: senkrechtes Wort von unten nach oben, Zahl dahinter */
  .va-strip { height: 100%; font: inherit; }
  .va-strip__btn {
    width: 100%; height: 100%; padding: 0 0 1.75rem; border: 0; background: none; cursor: pointer;
    display: flex; flex-direction: column-reverse; align-items: center; justify-content: flex-start; gap: 0.75rem;
  }
  .va-strip__btn .va-word, .va-strip__btn .va-count { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; }
  .va-strip__btn .va-word { font-size: calc(var(--strip) * 0.56); line-height: 1; }
  .va-strip__btn:hover .va-word { text-decoration-color: currentColor; }
</style>
