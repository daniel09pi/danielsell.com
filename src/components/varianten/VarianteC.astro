---
// TESTSEITE /varianten/: Variante C "Bänder".
// Statt drei Spalten drei Farbbänder untereinander (creative, adventure, dev), ohne Öffnen und Schließen.
// Pro Band links eine Textspalte, rechts ein Bildblock aus zwei Reihen. Oben links Titel, Metazeile mit
// "Featured project", Beschreibung, ein Link "View project"; unten links das große Wort mit der Projektzahl
// (Link auf alle Projekte des Bereichs). Die Versalhöhe des Titels liegt auf der Oberkante der Bilder,
// die Grundlinie des Wortes auf ihrer Unterkante (wie der Name im Hero auf der Kante der Flächen).
// Bildblock: zwei Reihen, in jeder Reihe alle Bilder gleich hoch und im eigenen Format, nichts beschnitten
// (flex-grow = Seitenverhältnis, die Reihe füllt die Breite genau). Welche Bilder in welche Reihe kommen, wird
// beim Bauen so gewählt, dass beide Reihen fast gleich hoch sind (Reihenfolge bleibt, möglichst nichts übersprungen).
// Unter dem Bildblock "All 9 images": öffnet die gemeinsame Vollbild-Ansicht (Galerie.astro).
// Ein Klick auf ein Bild öffnet sie bei genau diesem Bild. Kein eigenes JavaScript.
import VariantKopf from './VariantKopf.astro';
import Img from '../Img.astro';
import { CATEGORIES, featured, byCategory, categoryLabel, has } from '../../lib/content.js';
import { projectImages } from '../../lib/images.js';

// Ziel für die Summe der Seitenverhältnisse einer Reihe (drei 4:3-Bilder = 4).
const ZIEL = 4.2;

// Zwei Reihen wählen: Bild 1 steht immer vorn, die Reihenfolge bleibt. Bewertet werden
// Höhenunterschied der Reihen (wichtigster Punkt), Abstand zum Ziel und übersprungene Bilder.
function zweiReihen(all: any[]) {
  const n = Math.min(all.length, 10);
  let best: any = null;
  for (let mask = 1; mask < 1 << n; mask++) {
    if (!(mask & 1)) continue;
    const pick = all.slice(0, n).filter((_, i) => mask & (1 << i));
    if (pick.length < 4 || pick.length > 8) continue;
    const last = pick[pick.length - 1].i;
    const skips = last + 1 - pick.length;
    for (let k = 2; k <= Math.min(4, pick.length - 2); k++) {
      const a = pick.slice(0, k), b = pick.slice(k);
      if (b.length > 4) continue;
      const s1 = a.reduce((x, im) => x + im.r, 0), s2 = b.reduce((x, im) => x + im.r, 0);
      const avg = (s1 + s2) / 2;
      const cost = Math.abs(s1 - s2) / avg + 0.5 * Math.abs(avg - ZIEL) / ZIEL + 0.05 * skips - 0.01 * pick.length;
      if (!best || cost < best.cost) best = { cost, rows: [a, b] };
    }
  }
  return best ? best.rows : [all];
}

const bands = CATEGORIES.map((c) => {
  const p = featured(c);
  if (!p) return null;
  const count = byCategory(c).filter((x) => has(x.title)).length;
  // Gleiche Zählung wie in Galerie.astro: Platzhalter raus, dann durchnummerieren (data-bild).
  const all = projectImages(p)
    .filter((im) => !im.placeholder)
    .map((im, i) => ({ ...im, i, r: im.meta.width / im.meta.height }));
  const rows = zweiReihen(all).map((row: any[]) => {
    const sum = row.reduce((a, im) => a + im.r, 0);
    // sizes: der Bildblock ist 8 von 12 Spalten breit, etwa 62vw
    return row.map((im) => ({ ...im, vw: Math.round((im.r / sum) * 62) }));
  });
  const shown = rows.reduce((a: number, row: any[]) => a + row.length, 0);
  return {
    c,
    p,
    label: categoryLabel(c),
    count,
    total: all.length,
    shown,
    rows,
    meta: [p.kind, p.year].filter(has).join(', '),
  };
}).filter(Boolean) as any[];

const countLabel = (n: number) => `${n} ${n === 1 ? 'project' : 'projects'}`;
---
<VariantKopf
  buchstabe="C"
  name="Bänder"
  text="Drei Farbbänder untereinander statt Spalten, nichts zum Öffnen oder Schließen: links der Text, rechts sechs Bilder pro Projekt in zwei Reihen, alle drei Projekte auf einen Blick. Kein Bild wird beschnitten, jedes behält sein Format; ein Klick aufs Bild öffnet die Vollbild-Ansicht genau dort."
/>

<div class="vc">
  {bands.map((b) => (
    <section class:list={['vc-band', `vc-band--${b.c}`]} aria-labelledby={`vc-${b.c}`}>
      <div class="vc-spalte">
        <div class="vc-text">
          <h3 class="vc-titel">{b.p.title}</h3>
          <p class="vc-meta">
            {b.count > 1 && <span class="vc-featured">Featured project</span>}
            {b.meta}
          </p>
          {has(b.p.text) && <p class="vc-beschreibung">{b.p.text}</p>}
          <a class="vc-link" href={`/projects/${b.p.slug}/`}><span class="vc-link__text">View project</span><span aria-hidden="true"> →</span></a>
        </div>

        <p class="vc-kopf">
          <span class="vc-wort" id={`vc-${b.c}`}>{b.label}</span>
          {b.count > 1
            ? <a class="vc-zahl" href={`/projects/#${b.c}`} aria-label={`All ${b.count} ${b.label} projects`}>{countLabel(b.count)}</a>
            : <span class="vc-zahl">{countLabel(b.count)}</span>}
        </p>
      </div>

      <div class="vc-bilder">
        {b.rows.map((row: any[]) => (
          <div class="vc-reihe">
            {row.map((im: any) => (
              <button
                type="button"
                class="vc-bild"
                style={`flex-grow: ${im.r.toFixed(4)}; aspect-ratio: ${im.meta.width} / ${im.meta.height}`}
                data-galerie={b.p.slug}
                data-bild={im.i}
                aria-label={`${b.p.title}: open image ${im.i + 1} of ${b.total} in fullscreen`}
              >
                <Img meta={im.meta} alt={im.alt} sizes={`(min-width: 1100px) ${im.vw}vw, 90vw`} />
              </button>
            ))}
          </div>
        ))}
        {b.total > b.shown && (
          <button type="button" class="vc-alle" data-galerie={b.p.slug} data-bild="0">All {b.total} images</button>
        )}
      </div>
    </section>
  ))}
</div>

<style>
  .vc { margin-top: 1rem; }

  /* Farben pro Band wie bisher in den Spalten */
  .vc-band { background: var(--vc-bg); color: var(--vc-fg); }
  .vc-band--creative { --vc-bg: var(--field-creative); --vc-fg: var(--ink); --vc-soft: var(--ink-soft); }
  .vc-band--adventure { --vc-bg: var(--field-adventure); --vc-fg: var(--ground); --vc-soft: var(--line); }
  /* Auf Violett gibt es keinen helleren Text: Rangfolge nur über Größe */
  .vc-band--dev { --vc-bg: var(--field-dev); --vc-fg: var(--ink-deep); --vc-soft: var(--ink-deep); }
  .vc-band :focus-visible { outline-color: var(--vc-fg); }
  .vc-band--adventure :focus-visible { outline-color: var(--lime); }

  /* Oben Abstand bis zur Oberkante der Bilder; unten derselbe Abstand plus die Zeile "All 9 images" */
  .vc-band {
    --vc-pad: clamp(2.5rem, 6.5vh, 4.5rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    padding: var(--vc-pad) var(--margin) calc(var(--vc-pad) + 2.25rem);
  }

  /* Linke Spalte: Text oben, Wort unten. Sie ist so hoch wie der Bildblock. */
  .vc-spalte {
    grid-column: 1 / 5; min-width: 0;
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
  }

  /* Text: Titel > Art/Jahr > Beschreibung > ein Link. Versalhöhe des Titels = Oberkante der Bilder. */
  .vc-titel {
    font-size: clamp(2rem, 1.2rem + 1.6vw, 2.75rem); line-height: 1.05; font-weight: 450; letter-spacing: -0.025em;
    text-box: trim-start cap alphabetic;
  }
  .vc-meta { margin-top: 0.85rem; color: var(--vc-soft); font-size: 1rem; }
  .vc-featured::after { content: ' · '; }
  .vc-beschreibung { margin-top: 1.25rem; max-width: 46ch; }
  /* Hauptlink in Textgröße; unterstrichen ist nur das Wort, nicht der Pfeil */
  .vc-link { display: inline-block; margin-top: 1.1rem; padding-block: 0.3rem; font-weight: 500; text-decoration: none; }
  .vc-link__text {
    text-decoration: underline; text-decoration-thickness: 0.07em; text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    transition: text-decoration-color 0.2s var(--ease);
  }
  .vc-link:hover .vc-link__text { text-decoration-color: currentColor; }

  /* Wort und Projektzahl auf einer Grundlinie, die auf der Unterkante der Bilder liegt */
  .vc-kopf { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.75rem; }
  .vc-wort, .vc-zahl { text-box: trim-end cap alphabetic; }
  .vc-wort { font-size: var(--step-head); line-height: 0.95; letter-spacing: -0.035em; font-weight: 450; }
  .vc-zahl { color: var(--vc-soft); font-size: 1rem; }
  a.vc-zahl:hover { color: var(--vc-fg); }

  /* Bildblock: zwei Reihen. In jeder Reihe flex-grow = Seitenverhältnis bei Basis 0, also sind alle Bilder einer
     Reihe gleich hoch und füllen sie genau. Der Rahmen hat das Seitenverhältnis des Bildes; object-fit gleicht nur
     Rundungsreste unter einem Pixel aus, beschnitten wird nichts. */
  .vc-bilder { grid-column: 5 / 13; position: relative; display: grid; gap: 0.75rem; align-content: start; }
  .vc-reihe { display: flex; gap: 0.75rem; align-items: flex-start; }
  .vc-bild {
    position: relative; flex-shrink: 1; flex-basis: 0; min-width: 0;
    border: 0; background: none; padding: 0; margin: 0; cursor: zoom-in;
  }
  .vc-bild :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vc-bild:focus-visible { outline-offset: 4px; }

  /* Leise Beschriftung unter dem Bildblock, rechts bündig; zählt nicht zur Höhe (sonst stünde das Wort zu tief) */
  .vc-alle {
    position: absolute; top: 100%; right: 0;
    margin-top: 0.4rem; padding: 0.35rem 0; border: 0; background: none; cursor: zoom-in;
    color: var(--vc-soft); font-size: 1rem;
    text-decoration: underline; text-decoration-thickness: 0.07em; text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    transition: color 0.2s var(--ease), text-decoration-color 0.2s var(--ease);
  }
  .vc-alle:hover { color: var(--vc-fg); text-decoration-color: currentColor; }
</style>
