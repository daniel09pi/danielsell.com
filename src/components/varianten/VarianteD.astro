---
// TESTSEITE /varianten/: Variante D "Leitbild mit Index".
// Drei Farbspalten wie bisher. Ausgangszustand: pro Spalte ein Leitbild in seinem eigenen Format (nicht beschnitten;
// alle drei gleich hoch, Ober- und Unterkante auf einer Linie), direkt darunter eine Indexzeile mit kleinen
// quadratischen Vorschaubildern der übrigen Bilder (zeigt, wie viele es gibt), dann Titel, Metazeile mit
// "Featured project" und "View project". Unten Wort und Projektzahl (Zahl verlinkt auf alle Projekte des Bereichs).
// Offen: dasselbe, nur größer; Leitbild und Index links, Text rechts, Kreuz oben rechts, die anderen als Streifen.
// Der Index endet dort auf derselben Linie wie die drei senkrechten Wörter.
// Jeder Klick auf ein Bild öffnet die gemeinsame Vollbild-Ansicht (Galerie.astro) bei genau diesem Bild.
// Statisch: beide Zustände stehen untereinander.
import VariantKopf from './VariantKopf.astro';
import Img from '../Img.astro';
import { CATEGORIES, featured, byCategory, categoryLabel, has, isUrl, isExternal } from '../../lib/content.js';
import { projectImages } from '../../lib/images.js';

// Offen: das Leitbild steht in einem Feld von höchstens 4:3 (breitere füllen die Breite, schmalere die Höhe), oben bündig.
const FRAME_OPEN = 4 / 3;
// Breite in % (abgerundet, damit das Bild nie über das Feld hinausragt)
const pct = (r: number, frame: number) => Math.floor(Math.min(1, r / frame) * 10000) / 100;

const cols = CATEGORIES.map((c) => {
  const p = featured(c);
  if (!p) return null;
  const count = byCategory(c).filter((x) => has(x.title)).length;
  // Gleiche Zählung wie in Galerie.astro: Platzhalter raus, dann durchnummerieren (data-bild).
  const images = projectImages(p).filter((im) => !im.placeholder);
  if (images.length === 0) return null;
  const lead = images[0];
  const ratio = lead.meta.width / lead.meta.height;
  const meta = [p.kind, p.year].filter(has).join(', ');
  const links = (p.links ?? []).filter((l: any) => has(l?.label) && isUrl(l?.url));
  return { c, p, label: categoryLabel(c), count, images, lead, ratio, wOpen: pct(ratio, FRAME_OPEN), meta, links, featuredHint: count > 1 };
}).filter(Boolean) as any[];

// Ausgangszustand: alle drei Leitbilder gleich hoch. Das Feld hat das Format des breitesten Leitbilds (mindestens 4:3),
// jedes Bild füllt die Höhe in seinem eigenen Format. So liegen Ober- und Unterkanten in allen Spalten auf einer Linie.
const FRAME_EQUAL = Math.max(4 / 3, ...cols.map((x) => x.ratio));
for (const x of cols) x.wEqual = pct(x.ratio, FRAME_EQUAL);

const countLabel = (n: number) => `${n} ${n === 1 ? 'project' : 'projects'}`;
const imageLabel = (x: any, i: number) => `${x.p.title}: open image ${i + 1} of ${x.images.length} full screen`;
const open = cols.find((x) => x.c === 'creative') ?? cols[0];
---
<VariantKopf
  buchstabe="D"
  name="Leitbild mit Index"
  text="Pro Projekt ein Leitbild in seinem eigenen Format, nie beschnitten und in allen Spalten gleich hoch; direkt darunter kleine Quadrate für alle weiteren Bilder. Nur die Quadrate sind zugeschnitten, ein Klick zeigt jedes Bild ganz im Vollbild."
/>

<p class="v-zustand">Ausgangszustand</p>
<div class="vd-row vd-row--equal" style={`--frame:${FRAME_EQUAL.toFixed(4)}`}>
  {cols.map((x) => (
    <section class:list={['vd-col', `vd-col--${x.c}`]} aria-labelledby={`vd-${x.c}-word`}>
      <!-- Im HTML zuerst (Überschrift vor dem Inhalt), im Layout unten -->
      <h3 class="vd-label">
        <button type="button" class="vd-word" id={`vd-${x.c}-word`} aria-expanded="false">{x.label}</button>
        {x.count > 1
          ? <a class="vd-count" href={`/projects/#${x.c}`}>All {countLabel(x.count)}</a>
          : <span class="vd-count">{countLabel(x.count)}</span>}
      </h3>
      <div class="vd-proj">
        <div class="vd-pics">
          <div class="vd-frame">
            <button type="button" class="vd-lead" style={`--w:${x.wEqual}%`} data-galerie={x.p.slug} data-bild="0" aria-label={imageLabel(x, 0)}>
              <Img meta={x.lead.meta} alt="" sizes="(min-width: 960px) 30vw, 90vw" />
            </button>
          </div>
          {x.images.length > 1 && (
            <ul class="vd-index">
              {x.images.slice(1).map((im: any, j: number) => (
                <li>
                  <button type="button" class="vd-thumb" data-galerie={x.p.slug} data-bild={j + 1} aria-label={imageLabel(x, j + 1)}>
                    <Img meta={im.meta} alt="" sizes="96px" />
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="vd-text">
          <h4 class="vd-title">{x.p.title}</h4>
          <p class="vd-meta">{x.featuredHint && <>Featured project<span aria-hidden="true"> · </span><span class="sr-only">, </span></>}{x.meta}</p>
          <a class="vd-primary" href={`/projects/${x.p.slug}/`}>
            View project<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </section>
  ))}
</div>

<p class="v-zustand">Offen: {open.label}</p>
<div class="vd-row vd-row--open">
  {cols.map((x) => x === open ? (
    <section class:list={['vd-col', `vd-col--${x.c}`, 'vd-col--open']} aria-labelledby={`vd-${x.c}-word-o`}>
      <h3 class="vd-strip vd-strip--own">
        <button type="button" class="vd-strip__btn" id={`vd-${x.c}-word-o`} aria-expanded="true">
          <span class="vd-word">{x.label}</span>
        </button>
        {x.count > 1
          ? <a class="vd-count vd-strip__count" href={`/projects/#${x.c}`}>All {countLabel(x.count)}</a>
          : <span class="vd-count vd-strip__count">{countLabel(x.count)}</span>}
      </h3>
      <button type="button" class="vd-close" aria-label={`Close ${x.label}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <div class="vd-open">
        <div class="vd-pics">
          <div class="vd-frame">
            <button type="button" class="vd-lead" style={`--w:${x.wOpen}%`} data-galerie={x.p.slug} data-bild="0" aria-label={imageLabel(x, 0)}>
              <Img meta={x.lead.meta} alt="" sizes="(min-width: 960px) 50vw, 90vw" />
            </button>
          </div>
          {x.images.length > 1 && (
            <ul class="vd-index">
              {x.images.slice(1).map((im: any, j: number) => (
                <li>
                  <button type="button" class="vd-thumb" data-galerie={x.p.slug} data-bild={j + 1} aria-label={imageLabel(x, j + 1)}>
                    <Img meta={im.meta} alt="" sizes="128px" />
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="vd-text">
          <h4 class="vd-title vd-title--big">{x.p.title}</h4>
          <p class="vd-meta">{x.featuredHint && <>Featured project<span aria-hidden="true"> · </span><span class="sr-only">, </span></>}{x.meta}</p>
          {has(x.p.text) && <p class="vd-body">{x.p.text}</p>}
          <p class="vd-actions">
            <a class="vd-primary" href={`/projects/${x.p.slug}/`}>
              View project<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            </a>
            {x.links.map((l: any) => (
              <a class="vd-quiet" href={l.url} {...(isExternal(l.url) ? { rel: 'noopener', target: '_blank' } : {})}>
                {l.label}{isExternal(l.url) && <><span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></>}
              </a>
            ))}
          </p>
        </div>
      </div>
    </section>
  ) : (
    <section class:list={['vd-col', `vd-col--${x.c}`, 'vd-col--strip']} aria-labelledby={`vd-${x.c}-word-s`}>
      <h3 class="vd-strip">
        <button type="button" class="vd-strip__btn" id={`vd-${x.c}-word-s`} aria-expanded="false">
          <span class="vd-strip__set">
            <span class="vd-word">{x.label}</span>
            <span class="vd-count">{countLabel(x.count)}</span>
          </span>
        </button>
      </h3>
    </section>
  ))}
</div>

<style>
  /* Spalten und Farben wie bisher; Text pro Fläche in ihrer Schriftfarbe */
  .vd-row {
    --strip: clamp(4.5rem, 6.5vw, 6.5rem);
    --h: clamp(36rem, 80svh, 52rem);   /* knapp eine Bildschirmhöhe; die Luft über dem Wort bleibt ruhig, aber nicht leer */
    --top: var(--margin);     /* Abstand oben = Abstand links: Bild und Kreuz sitzen in einer gleichmäßigen Ecke */
    --gap: 0.5rem;            /* Abstand im Index und zwischen Leitbild und Index */
    --cells: 8;               /* Felder pro Indexzeile, in allen Spalten gleich: die Länge der Zeile zeigt die Bildzahl */
    display: flex;
    min-height: var(--h);
  }
  .vd-col { position: relative; min-width: 0; background: var(--bg); color: var(--fg); }
  .vd-col--creative { --bg: var(--field-creative); --fg: var(--ink); --soft: var(--ink-soft); }
  .vd-col--adventure { --bg: var(--field-adventure); --fg: var(--ground); --soft: var(--line); }
  .vd-col--dev { --bg: var(--field-dev); --fg: var(--ink-deep); --soft: var(--ink-deep); }
  .vd-col :focus-visible { outline-color: var(--fg); }

  /* ---------- Bilder: Leitbild + Index ---------- */
  /* Ausgangszustand: das Feld hat das Format des breitesten Leitbilds, jedes Leitbild füllt seine Höhe (links bündig).
     So stehen alle drei Bilder gleich hoch, Ober- und Unterkante auf einer Linie; nichts wird beschnitten.
     Offen: kein festes Feld, das Bild steht oben bündig, der Index folgt direkt darunter. */
  .vd-frame { display: flex; align-items: flex-end; }
  .vd-row--equal .vd-frame { aspect-ratio: var(--frame); }
  .vd-lead {
    display: block; width: var(--w, 100%);
    padding: 0; border: 0; background: none; cursor: zoom-in;
  }
  .vd-lead :global(picture) { display: block; }
  .vd-lead :global(img) { width: 100%; height: auto; }

  /* Index: kleine Quadrate (nur hier wird zugeschnitten), feste Zahl Felder pro Zeile */
  .vd-index {
    display: grid; grid-template-columns: repeat(var(--cells), minmax(0, 1fr)); gap: var(--gap);
    margin-top: var(--gap);
  }
  .vd-thumb {
    display: block; width: 100%; aspect-ratio: 1;
    padding: 0; border: 0; background: none; cursor: zoom-in;
  }
  .vd-thumb :global(picture) { display: block; width: 100%; height: 100%; }
  .vd-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* Hover: nur ein Rahmen in der Schriftfarbe, nichts bewegt sich */
  .vd-lead, .vd-thumb { outline: 2px solid transparent; outline-offset: 2px; transition: outline-color 0.2s var(--ease); }
  .vd-lead:hover, .vd-thumb:hover { outline-color: var(--fg); }

  /* ---------- Text ---------- */
  .vd-title { font-size: clamp(1.5rem, 1.1rem + 0.9vw, 2rem); line-height: 1.1; font-weight: 450; letter-spacing: -0.02em; }
  /* "Featured project" steht in der Metazeile direkt unter dem Titel */
  .vd-meta { margin-top: 0.35rem; color: var(--soft); font-size: 1rem; line-height: 1.4; }
  .vd-primary {
    display: inline-flex; align-items: center; gap: 0.45em; min-height: 2.75rem;
    font-size: var(--step-body); font-weight: 500; text-underline-offset: 0.25em;
  }
  .vd-primary svg { flex: none; width: 0.9em; height: 0.9em; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: square; }
  .vd-quiet { color: var(--soft); font-size: var(--step-small); }
  .vd-quiet:hover { color: var(--fg); }

  /* ---------- Wort und Projektzahl ---------- */
  .vd-label { display: flex; align-items: baseline; gap: 0.75rem; padding: 1.25rem var(--margin) 1.75rem; font: inherit; }
  .vd-word {
    padding: 0; border: 0; background: none; color: inherit; cursor: pointer; text-align: left;
    font-size: var(--step-head); line-height: 0.95; letter-spacing: -0.035em; font-weight: 450;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 0.04em; text-underline-offset: 0.14em;
    transition: text-decoration-color 0.25s var(--ease);
  }
  .vd-word:hover { text-decoration-color: currentColor; }
  .vd-count { color: var(--soft); font-size: var(--step-small); }
  a.vd-count:hover { color: var(--fg); }

  /* ---------- Ausgangszustand ---------- */
  .vd-row--equal .vd-col { flex: 1 1 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; }
  .vd-row--equal .vd-label { grid-row: 2; grid-column: 1; }
  .vd-proj { grid-row: 1; grid-column: 1; padding: var(--top) var(--margin) 1.5rem; }
  .vd-proj .vd-text { margin-top: 1.5rem; }
  .vd-proj .vd-primary { margin-top: 0.5rem; }

  /* ---------- Offen ---------- */
  /* Höhe aus dem Inhalt: unten 1.75rem wie unter den Wörtern, so enden Index und alle drei Wörter auf einer Linie */
  .vd-row--open { min-height: 0; }
  .vd-row--open .vd-col--strip { flex: 0 0 var(--strip); }
  .vd-row--open .vd-col--open { flex: 1 1 auto; display: grid; grid-template-columns: var(--strip) minmax(0, 1fr); }
  .vd-open {
    grid-column: 2;
    /* Bilder gut die Hälfte; nie so hoch, dass Leitbild + Index nicht in die Spalte passen (Höhe = 7/8 der Breite) */
    display: grid; grid-template-columns: minmax(0, min(62%, calc((var(--h) - 2 * var(--top)) * 8 / 7))) minmax(0, 1fr);
    column-gap: clamp(2.5rem, 4.5vw, 5rem); align-items: start;
    padding: var(--top) var(--margin) 1.75rem 0;
  }
  .vd-open .vd-text { padding-top: 0; }
  .vd-title--big { font-size: clamp(2rem, 1.2rem + 1.6vw, 2.75rem); line-height: 1.05; letter-spacing: -0.025em; margin-top: -0.1em; padding-right: 3rem; }
  .vd-open .vd-meta { margin-top: 0.5rem; }
  .vd-body { margin-top: 1.5rem; max-width: 36ch; }
  .vd-actions { margin-top: 1.25rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1.5rem; }

  .vd-close {
    position: absolute; z-index: 1;
    top: calc(var(--top) - 0.625rem); right: calc(var(--margin) - 0.625rem);
    width: 2.75rem; height: 2.75rem; display: grid; place-items: center;
    padding: 0; border: 0; background: none; color: inherit; cursor: pointer;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .vd-close svg { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; }
  .vd-close:hover { background: var(--fg); color: var(--bg); }

  /* Streifen: senkrechtes Wort von unten nach oben, Zahl dahinter */
  .vd-strip {
    grid-column: 1; height: 100%; font: inherit;
    display: flex; flex-direction: column-reverse; align-items: center; justify-content: flex-start; gap: 0.75rem;
    padding-bottom: 1.75rem;
  }
  .vd-strip__btn {
    padding: 0; border: 0; background: none; color: inherit; cursor: pointer;
    display: flex; flex-direction: column; justify-content: flex-end; align-items: center;
  }
  /* Ganzer Streifen klickbar; Wort mittig im Streifen */
  .vd-col--strip .vd-strip__btn { flex: 1 1 auto; width: 100%; }
  /* Zahl auf der Grundlinie des Worts wie im Ausgangszustand (nach der Drehung liegt die Grundlinie rechts) */
  .vd-strip__set, .vd-strip--own { display: flex; flex-direction: column-reverse; align-items: flex-end; gap: 0.75rem; }
  .vd-strip--own { justify-self: center; }
  .vd-strip .vd-word, .vd-strip .vd-count { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; }
  .vd-strip .vd-word { font-size: calc(var(--strip) * 0.56); line-height: 1; }
  .vd-strip__btn:hover .vd-word { text-decoration-color: currentColor; }
</style>
