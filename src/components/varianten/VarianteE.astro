---
// TESTSEITE /varianten/: Variante E "Magazin".
// Drei Farbspalten wie bisher, gesetzt wie eine ruhige Zeitschriften-Doppelseite auf einem festen Raster.
// Ausgangszustand: pro Spalte ein großes und ein kleines Bild (beide ungeschnitten, im Seitenverhältnis des Originals),
// neben dem kleinen Bild die Bildunterschrift mit Titel, Art/Jahr, Hinweis "Featured project" und "View project".
// Gleiche Höhe statt gleicher Breite: Die Breite jedes großen Bildes ist (eigenes Format ÷ breitestes Format) der Satzbreite.
// So sind die großen Bilder in allen drei Spalten exakt gleich hoch, das breiteste füllt die Spalte, keines wird beschnitten.
// Offen: ein Bildblock auf Spalte 1–8 des 12er-Rasters, großes Bild links, drei kleine untereinander rechts. Die Breite
// der kleinen Spalte wird aus den Formaten berechnet, damit beide Seiten genau gleich hoch sind (alle vier Kanten auf dem Raster).
// Text hängt rechts an derselben Oberkante, Kreuz oben rechts, die anderen Spalten als Streifen.
// Ein Klick auf ein Bild öffnet die gemeinsame Vollbild-Ansicht (Galerie.astro) bei genau diesem Bild.
// Statisch: beide Zustände stehen untereinander.
import VariantKopf from './VariantKopf.astro';
import Img from '../Img.astro';
import { CATEGORIES, featured, byCategory, categoryLabel, has, isUrl, isExternal } from '../../lib/content.js';
import { projectImages } from '../../lib/images.js';

const ratio = (im: any) => (im ? im.meta.width / im.meta.height : 1);
const num = (n: number) => +n.toFixed(4);

const cols = CATEGORIES.map((c) => {
  const p = featured(c);
  if (!p) return null;
  const count = byCategory(c).filter((x) => has(x.title)).length;
  // Gleiche Zählung wie in Galerie.astro: Platzhalter raus, dann durchnummerieren (data-bild).
  const images = projectImages(p).filter((im) => !im.placeholder);
  const meta = [p.kind, p.year].filter(has).join(', ');
  const links = (p.links ?? []).filter((l: any) => has(l?.label) && isUrl(l?.url));
  // Offen: großes Bild (Format R) neben n kleinen (Summe der Kehrwerte S) – Breite der kleinen Spalte so, dass beide gleich hoch sind.
  const stack = images.slice(1, 4);
  const R = ratio(images[0]);
  const S = stack.reduce((s: number, im: any) => s + 1 / ratio(im), 0);
  return {
    c, p, label: categoryLabel(c), count, images, meta, links, stack,
    featuredHint: count > 1,
    r0: num(ratio(images[0])), r1: num(ratio(images[1])),
    R: num(R), RS1: num(R * S + 1), GK: num(1 + Math.max(stack.length - 1, 0) * R),
  };
}).filter(Boolean) as any[];

// Breitestes Format pro Bildreihe im Ausgangszustand: dieses Bild füllt die Spalte, die anderen werden schmaler, nicht niedriger.
const rmaxBig = Math.max(...cols.map((x) => x.r0));
const rmaxSmall = Math.max(...cols.map((x) => x.r1));

const countLabel = (n: number) => `${n} ${n === 1 ? 'project' : 'projects'}`;
const shotLabel = (x: any, i: number) => `${x.p.title}: open image ${i + 1} of ${x.images.length} full screen`;
const open = cols.find((x) => x.c === 'creative') ?? cols[0];
---
<VariantKopf
  buchstabe="E"
  name="Magazin"
  text="Jede Spalte ist gesetzt wie eine ruhige Zeitschriftenseite: ein großes Bild, darunter ein kleines mit Titel und „View project“ als Bildunterschrift; offen wird daraus eine Doppelseite mit vier Bildern. Nichts wird beschnitten: Nur die Breite der Bilder passt sich an, damit sie überall gleich hoch sind."
/>

<p class="v-zustand">Ausgangszustand</p>
<div class="ve-row ve-row--equal" style={`--rmax:${rmaxBig};--rmax-s:${rmaxSmall}`}>
  {cols.map((x) => (
    <section class:list={['ve-col', `ve-col--${x.c}`]} aria-labelledby={`ve-${x.c}-word`}>
      <h3 class="ve-label">
        <button type="button" class="ve-word" id={`ve-${x.c}-word`} aria-expanded="false">{x.label}</button>
        {x.count > 1
          ? <a class="ve-count" href={`/projects/#${x.c}`}>{countLabel(x.count)}</a>
          : <span class="ve-count">{countLabel(x.count)}</span>}
      </h3>

      {x.images[0] && (
        <button type="button" class="ve-shot ve-big" style={`--r:${x.r0}`} data-galerie={x.p.slug} data-bild="0" aria-label={shotLabel(x, 0)}>
          <Img meta={x.images[0].meta} alt="" sizes="(min-width: 960px) 30vw, 90vw" />
        </button>
      )}

      <div class="ve-pair">
        <div class="ve-cap">
          <h4 class="ve-title">{x.p.title}</h4>
          <p class="ve-meta">{x.meta}</p>
          {x.featuredHint && <p class="ve-meta">Featured project</p>}
          <a class="ve-primary" href={`/projects/${x.p.slug}/`}>
            View project<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
          </a>
        </div>
        {x.images[1] && (
          <button type="button" class="ve-shot ve-small" style={`--r:${x.r1}`} data-galerie={x.p.slug} data-bild="1" aria-label={shotLabel(x, 1)}>
            <Img meta={x.images[1].meta} alt="" sizes="(min-width: 960px) 15vw, 45vw" />
          </button>
        )}
      </div>
    </section>
  ))}
</div>

<p class="v-zustand">Offen: {open.label}</p>
<div class="ve-row ve-row--open">
  {cols.map((x) => x === open ? (
    <section class:list={['ve-col', `ve-col--${x.c}`, 've-col--open']} aria-labelledby={`ve-${x.c}-word-o`}>
      <h3 class="ve-label">
        <button type="button" class="ve-word" id={`ve-${x.c}-word-o`} aria-expanded="true">{x.label}</button>
        {x.count > 1
          ? <a class="ve-count" href={`/projects/#${x.c}`}>{countLabel(x.count)}</a>
          : <span class="ve-count">{countLabel(x.count)}</span>}
      </h3>
      <button type="button" class="ve-close" aria-label={`Close ${x.label}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>

      <div class:list={['ve-spread', { 've-spread--solo': x.stack.length === 0 }]} style={`--R:${x.R};--RS1:${x.RS1};--GK:${x.GK}`}>
        {x.images[0] && (
          <button type="button" class="ve-shot ve-obig" data-galerie={x.p.slug} data-bild="0" aria-label={shotLabel(x, 0)}>
            <Img meta={x.images[0].meta} alt="" sizes="(min-width: 960px) 45vw, 90vw" />
          </button>
        )}
        {x.stack.length > 0 && (
          <ul class="ve-stack">
            {x.stack.map((im: any, j: number) => (
              <li>
                <button type="button" class="ve-shot" data-galerie={x.p.slug} data-bild={j + 1} aria-label={shotLabel(x, j + 1)}>
                  <Img meta={im.meta} alt="" sizes="(min-width: 960px) 14vw, 45vw" />
                </button>
              </li>
            ))}
          </ul>
        )}
        {x.images.length > 4 && (
          <p class="ve-more">
            <button type="button" class="ve-all" data-galerie={x.p.slug} data-bild="0">All {x.images.length} images</button>
          </p>
        )}
      </div>

      <div class="ve-text">
        <h4 class="ve-title ve-title--big">{x.p.title}</h4>
        <p class="ve-meta">{x.meta}</p>
        {x.featuredHint && <p class="ve-meta">Featured project</p>}
        {has(x.p.text) && <p class="ve-body">{x.p.text}</p>}
        <p class="ve-actions">
          <a class="ve-primary" href={`/projects/${x.p.slug}/`}>
            View project<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
          </a>
          {x.links.map((l: any) => (
            <a class="ve-quiet" href={l.url} {...(isExternal(l.url) ? { rel: 'noopener', target: '_blank' } : {})}>
              {l.label}{isExternal(l.url) && <><span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></>}
            </a>
          ))}
        </p>
      </div>
    </section>
  ) : (
    <section class:list={['ve-col', `ve-col--${x.c}`, 've-col--strip']} aria-labelledby={`ve-${x.c}-word-s`}>
      <h3 class="ve-strip">
        <button type="button" class="ve-strip__btn" id={`ve-${x.c}-word-s`} aria-expanded="false">
          <span class="ve-word">{x.label}</span>
          <span class="ve-count">{countLabel(x.count)}</span>
        </button>
      </h3>
    </section>
  ))}
</div>

<style>
  /* Spalten und Farben wie bisher; Text pro Fläche in ihrer Schriftfarbe */
  .ve-row {
    --strip: clamp(4.5rem, 6.5vw, 6.5rem);
    --top: clamp(3.5rem, 9vh, 5rem);             /* Hängelinie: hier beginnen Bilder und Text */
    --hang: clamp(2.5rem, 6vh, 4rem);            /* Abstand zur zweiten Hängelinie (Bildunterschrift + kleines Bild) */
    min-height: clamp(36rem, 80svh, 56rem);
  }
  .ve-col { position: relative; min-width: 0; background: var(--bg); color: var(--fg); }
  .ve-col--creative { --bg: var(--field-creative); --fg: var(--ink); --soft: var(--ink-soft); }
  .ve-col--adventure { --bg: var(--field-adventure); --fg: var(--ground); --soft: var(--line); }
  .ve-col--dev { --bg: var(--field-dev); --fg: var(--ink-deep); --soft: var(--ink-deep); }
  .ve-col :focus-visible { outline-color: var(--fg); }
  .ve-col a { color: inherit; }

  /* Bilder: ungeschnitten, Höhe aus dem Format. Hover: nur eine feine Rahmenlinie in Schriftfarbe, nichts bewegt sich.
     Tastatur: dieselbe Linie, kräftiger. */
  .ve-shot {
    display: block; width: 100%;
    padding: 0; border: 0; background: none; cursor: zoom-in;
    outline: 1px solid transparent; outline-offset: 5px;
    transition: outline-color 0.2s var(--ease);
  }
  .ve-shot:hover { outline-color: var(--fg); }
  .ve-shot:focus-visible { outline: 2px solid var(--fg); outline-offset: 5px; }
  .ve-shot :global(picture) { display: block; }
  .ve-shot :global(img) { width: 100%; height: auto; }

  /* ---------- Ausgangszustand ----------
     Die drei Spalten teilen sich die Zeilen (subgrid): großes Bild, Bildunterschrift + kleines Bild, Luft, Wort.
     So liegen Bildkanten, Bildunterschriften und "View project" in allen drei Spalten auf denselben Linien. */
  .ve-row--equal {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto minmax(2.5rem, 1fr) auto;
  }
  .ve-row--equal .ve-col {
    grid-row: 1 / -1;
    display: grid; grid-template-rows: subgrid; grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--gutter); row-gap: 0;
    padding: var(--top) var(--margin) 0;
  }
  /* Gleich hoch statt gleich breit: das breiteste Format füllt die Satzbreite, die anderen stehen links bündig schmaler */
  .ve-big { grid-row: 1; grid-column: 1 / -1; justify-self: start; align-self: start; width: calc(100% * var(--r) / var(--rmax)); }
  /* Bildunterschrift und kleines Bild als Paar: Titel hängt an der Oberkante des Bildes, "View project" steht auf seiner Unterkante */
  .ve-pair { grid-row: 2; grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; margin-top: var(--hang); }
  .ve-cap { grid-column: 1 / 4; display: flex; flex-direction: column; align-items: flex-start; }
  .ve-small { grid-column: 4 / 7; justify-self: end; align-self: start; width: calc(100% * var(--r) / var(--rmax-s)); }
  .ve-row--equal .ve-label { grid-row: 4; grid-column: 1 / -1; }

  /* Bildunterschrift: Titel hängt mit der Versalhöhe an der Oberkante des kleinen Bildes */
  .ve-title { font-size: clamp(1.25rem, 1rem + 0.5vw, 1.5rem); line-height: 1.15; font-weight: 450; letter-spacing: -0.015em; text-box: trim-start cap alphabetic; }
  .ve-meta { color: var(--soft); font-size: var(--step-small); line-height: 1.45; }
  .ve-title + .ve-meta { margin-top: 0.5rem; }
  .ve-cap .ve-primary { margin-top: auto; padding-top: 1rem; }

  /* Der eine Hauptlink: Fließtextgröße, etwas kräftiger, kleiner Pfeil */
  .ve-primary {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-size: var(--step-body); font-weight: 500; line-height: 1.2; text-underline-offset: 0.25em;
  }
  .ve-primary svg { flex: none; width: 0.85em; height: 0.85em; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: square; }

  /* Wort + Projektzahl unten; die Zahl führt zu allen Projekten des Bereichs */
  .ve-label { display: flex; align-items: baseline; gap: 0.75rem; padding: 1.25rem 0 1.75rem; font: inherit; }
  .ve-word {
    padding: 0; border: 0; background: none; color: inherit; cursor: pointer; text-align: left;
    font-size: var(--step-head); line-height: 0.95; letter-spacing: -0.035em; font-weight: 450;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 0.04em; text-underline-offset: 0.14em;
    transition: text-decoration-color 0.25s var(--ease);
  }
  .ve-word:hover { text-decoration-color: currentColor; }
  .ve-count { color: var(--soft); font-size: var(--step-small); }
  a.ve-count:hover { color: var(--fg); }

  /* ---------- Offen ----------
     Raster mit 12 Spalten: Bildblock auf 1–8, Text auf 9–12. Alles hängt an derselben Oberkante. */
  .ve-row--open { display: flex; }
  .ve-col--strip { flex: 0 0 var(--strip); }
  .ve-col--open {
    flex: 1 1 auto;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto minmax(2rem, 1fr) auto;
    column-gap: var(--gutter); row-gap: 0;
    padding: var(--top) var(--margin) 0;
  }
  /* Bildblock: großes Bild + Spalte mit kleinen Bildern, beide exakt gleich hoch.
     Breite der kleinen Spalte w aus (W ÷ R) = w · S + (n − 1) · Abstand und W + Abstand + w = 100 %. */
  .ve-spread {
    grid-row: 1; grid-column: 1 / 9; align-self: start;
    display: grid; align-items: start; column-gap: var(--gutter);
    grid-template-columns: minmax(0, 1fr) calc((100% - var(--gutter) * var(--GK)) / var(--RS1));
  }
  .ve-spread--solo { grid-template-columns: minmax(0, 1fr); }
  .ve-obig { grid-row: 1; grid-column: 1; }
  .ve-stack { grid-row: 1; grid-column: 2; display: grid; gap: var(--gutter); }
  .ve-more { grid-row: 2; grid-column: 2; }
  /* Text hängt oben an der Bildkante; Beschreibung und Link folgen, unten bleibt Luft */
  .ve-text {
    grid-row: 1; grid-column: 9 / 13; align-self: start;
    display: flex; flex-direction: column; align-items: flex-start;
    padding-left: var(--gutter);
  }
  .ve-col--open .ve-label { grid-row: 3; grid-column: 1 / -1; }

  .ve-title--big { font-size: clamp(2rem, 1.2rem + 1.6vw, 2.75rem); line-height: 1.05; letter-spacing: -0.025em; }
  .ve-text .ve-meta { font-size: 1rem; }
  .ve-text .ve-title + .ve-meta { margin-top: 0.75rem; }
  .ve-body { margin-top: 1.75rem; max-width: 36ch; }
  .ve-actions { margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 1.5rem; }
  .ve-quiet { color: var(--soft); font-size: var(--step-small); }
  .ve-quiet:hover { color: var(--fg); }

  /* Kleine Bildunterschrift unter der Bildspalte: es gibt mehr Bilder, alle im Vollbild */
  .ve-all {
    margin-top: 0.5rem; padding: 0.35rem 0; border: 0; background: none; cursor: zoom-in;
    color: var(--soft); font-size: var(--step-small); text-align: left;
    text-decoration: underline; text-decoration-thickness: 0.07em; text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    transition: color 0.2s var(--ease), text-decoration-color 0.2s var(--ease);
  }
  .ve-all:hover { color: var(--fg); text-decoration-color: currentColor; }

  .ve-close {
    position: absolute; z-index: 1;
    top: calc((var(--top) - 2.75rem) / 2); right: calc(var(--margin) - 0.625rem);
    width: 2.75rem; height: 2.75rem; display: grid; place-items: center;
    padding: 0; border: 0; background: none; color: inherit; cursor: pointer;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .ve-close svg { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; }
  .ve-close:hover { background: var(--fg); color: var(--bg); }

  /* Streifen: senkrechtes Wort von unten nach oben, Zahl dahinter; Hover nur Unterstreichung */
  .ve-strip { height: 100%; font: inherit; }
  .ve-strip__btn {
    width: 100%; height: 100%; padding: 0 0 1.75rem; border: 0; background: none; color: inherit; cursor: pointer;
    display: flex; flex-direction: column-reverse; align-items: center; justify-content: flex-start; gap: 0.75rem;
  }
  .ve-strip__btn .ve-word, .ve-strip__btn .ve-count { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; }
  /* Wo möglich ohne Drehung: Schrift von unten nach oben gesetzt */
  @supports (writing-mode: sideways-lr) {
    .ve-strip__btn .ve-word, .ve-strip__btn .ve-count { writing-mode: sideways-lr; transform: none; }
  }
  .ve-strip__btn .ve-word { font-size: calc(var(--strip) * 0.56); line-height: 1; }
  .ve-strip__btn:hover .ve-word { text-decoration-color: currentColor; }
</style>
