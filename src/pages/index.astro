---
import Base from '../layouts/Base.astro';
import Areas from '../components/Areas.astro';
import Closing from '../components/Closing.astro';
import Img from '../components/Img.astro';
import T from '../components/T.astro';
import { site, has, isPlaceholder, isUrl, isExternal, CATEGORIES, byCategory, subtitleLinks, formatDate, parseMarks } from '../lib/content.js';
import { resolveImage } from '../lib/images.js';
import { bandPools } from '../lib/band.js';

const name = site.person?.name ?? '';
const words = subtitleLinks();
// Hero: eine Spalte pro Bereich, in der Reihenfolge creative, adventure, dev. Wort aus hero.subtitle, darunter die Projekttitel.
const areas = CATEGORIES.map((c) => ({
  category: c,
  word: words.find((w) => w.category === c)?.word ?? c,
  projects: byCategory(c).filter((p) => has(p.title)),
}));
// Rolle: Text ohne Klammern; die Bereiche darin ({creative: design}) ergeben ein Quadrat vorne, bei zwei Bereichen
// links die Farbe des ersten, rechts die des zweiten.
const currently = (site.currently?.items ?? []).filter((i) => has(i?.title) || has(i?.text)).map((i) => {
  const parts = has(i.role) ? parseMarks(i.role) : [];
  const cats = [...new Set(parts.filter((x) => x.category).map((x) => x.category))];
  return { ...i, roleText: parts.map((x) => x.text).join(''), roleCats: cats };
});
const about = site.about ?? {};
const photo = has(about.photo?.src) && !isPlaceholder(about.photo.src) ? resolveImage(about.photo.src) : null;
const facts = (about.facts ?? []).filter((f) => has(f?.label) && has(f?.value));
const ph = (v) => (isPlaceholder(v) ? 'ph' : undefined);
const quote = site.quote ?? {};
// Laufband im Hero: Bilder pro Bereich mit Hauptfarbe (src/lib/band.js), Ablauf in src/scripts/band.ts
const pools = await bandPools();
---
<Base nav={[{ label: 'work', href: '#work' }, { label: 'about', href: '#about' }, { label: 'contact', href: '#contact' }]}>
  {/* Steuerung des Laufbands, mittig in der Navigation: Start/Stopp, Position (zum Verschieben), Farbe statt Schwarzweiß.
      Verborgen, bis das Skript läuft (ohne JS gibt es kein Band). */}
  <div class="lbc" slot="nav-center" role="group" aria-label="Image band" hidden>
    <button class="lbc__btn lbc__play" id="lbc-play" type="button" aria-label="Pause the image band">
      <svg class="lbc__pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="3" width="2.4" height="10" /><rect x="9.6" y="3" width="2.4" height="10" /></svg>
      <svg class="lbc__resume" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" /></svg>
    </button>
    <div class="lbc__bar" id="lbc-bar" role="slider" tabindex="0" aria-label="Position of the image band" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="lbc__track"><span class="lbc__fill" id="lbc-fill"></span></span>
      <span class="lbc__knob" id="lbc-knob"></span>
    </div>
    <button class="lbc__btn lbc__color" id="lbc-color" type="button" aria-pressed="false" aria-label="Show images in colour">
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.3" /><path class="lbc__half" d="M8 2.5a5.5 5.5 0 0 1 0 11z" /></svg>
    </button>
  </div>
  {/* Ladeanimation: nur einmal pro Besuch (Tab), nicht bei reduzierter Bewegung, ohne JS gar nicht. Steht vor dem Hero und
      läuft sofort, damit nichts erst sichtbar ist und dann verschwindet. ?intro in der Adresse erzwingt sie. */}
  <script is:inline>
    (function () {
      try {
        var force = /[?&]intro/.test(location.search);
        if (!force && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!force && sessionStorage.getItem('ds-intro')) return;
        sessionStorage.setItem('ds-intro', '1');
        document.documentElement.classList.add('intro');
      } catch (e) {}
    })();
  </script>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__stage" id="lb-stage">
      {areas.map((a) => <div class:list={['hero__field', `hero__field--${a.category}`]} aria-hidden="true"></div>)}
      <div class="lb" id="lb" aria-hidden="true"></div>
      <h1 class="hero__name" id="hero-title">{name.toLowerCase()}</h1>
    </div>
    <ul class="hero__index">
      {areas.map((a) => (
        <li class:list={['hero__area', `hero__area--${a.category}`]}>
          <a class="hero__word" href={`#${a.category}`}><T v={a.word} /></a>
          {a.projects.length > 0 && <ul class="hero__titles">{a.projects.map((p) => <li><a href={`/projects/${p.slug}/`}><T v={p.title} /></a></li>)}</ul>}
        </li>
      ))}
    </ul>
  </section>

  <section class:list={["letter wrap", { "letter--nophoto": !photo }]} id="about" {...(has(about.greeting) ? { "aria-labelledby": "about-title" } : { "aria-label": "About" })}>
    {photo && (
      <figure class="letter__photo tilt" style="--tilt:-0.6deg;--tilt-to:0.4deg">
        <Img meta={photo} alt={about.photo.alt ?? ''} sizes="(min-width: 960px) 36vw, 84vw" />
        {has(about.photo?.caption) && <figcaption><T v={about.photo.caption} /></figcaption>}
      </figure>
    )}
    <div class="letter__text">
      {has(about.greeting) && <h2 class="letter__title" id="about-title"><a href="/about/"><T v={about.greeting} /></a></h2>}
      {has(about.intro) && <p class="letter__intro"><T v={about.intro} /></p>}
      {facts.length > 0 && (
        <dl class="letter__facts">
          {facts.map((f) => (
            <div><dt>{f.label}</dt><dd><T v={f.value} /></dd></div>
          ))}
        </dl>
      )}
    </div>
  </section>

  {currently.length > 0 && (
    <section class="now wrap" {...(has(site.currently?.title) ? { "aria-labelledby": "now-title" } : { "aria-label": "Currently" })}>
      {has(site.currently?.title) && <h2 class="now__title" id="now-title"><T v={site.currently.title} /></h2>}
      {has(site.currently?.updated) && (
        <p class="now__updated">Updated <time datetime={site.currently.updated}>{formatDate(site.currently.updated)}</time></p>
      )}
      <ul class="now__list">
        {currently.map((item) => (
          <li class="now__row">
            <div class="now__head">
              <h3 class="now__item">
                {isUrl(item.url) ? (
                  <a href={item.url} {...(isExternal(item.url) ? { rel: 'noopener', target: '_blank' } : {})}><T v={item.title} />{isExternal(item.url) && <><span class="now__ext" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></>}</a>
                ) : <T v={item.title} />}
              </h3>
              {has(item.roleText) && (
                <p class="now__role">
                  {item.roleCats.length > 0 && <span class="now__swatch" style={`--a:var(--field-${item.roleCats[0]});--b:var(--field-${item.roleCats[item.roleCats.length - 1]})`} aria-hidden="true"></span>}
                  {item.roleText}
                </p>
              )}
            </div>
            {has(item.text) && <p class="now__text"><T v={item.text} /></p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <Areas />

  {has(quote.text) && (
    <section class="quote wrap" aria-label={has(quote.label) ? quote.label : 'In short'}>
      {has(quote.label) && <p class="quote__label" aria-hidden="true"><T v={quote.label} /></p>}
      <blockquote class="quote__text"><p>{parseMarks(quote.text).map((part) => part.category ? <span class:list={["mark", `mark--${part.category}`]}>{part.text}</span> : part.text)}</p></blockquote>
    </section>
  )}

  <Closing slot="after" />
  <script type="application/json" id="lb-data" set:html={JSON.stringify(pools)}></script>
</Base>

<script>
  import '../scripts/band.ts';
</script>
