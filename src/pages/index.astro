---
import Base from '../layouts/Base.astro';
import Areas from '../components/Areas.astro';
import Closing from '../components/Closing.astro';
import Img from '../components/Img.astro';
import T from '../components/T.astro';
import { site, has, isPlaceholder, CATEGORIES, byCategory, subtitleLinks, formatDate } from '../lib/content.js';
import { resolveImage } from '../lib/images.js';

const name = site.person?.name ?? '';
const words = subtitleLinks();
// Hero: eine Spalte pro Bereich, in der Reihenfolge creative, adventure, dev. Wort aus hero.subtitle, darunter die Projekttitel.
const areas = CATEGORIES.map((c) => ({
  category: c,
  word: words.find((w) => w.category === c)?.word ?? c,
  projects: byCategory(c).filter((p) => has(p.title)),
}));
const currently = (site.currently?.items ?? []).filter((i) => has(i?.title) || has(i?.text));
const about = site.about ?? {};
const photo = has(about.photo?.src) && !isPlaceholder(about.photo.src) ? resolveImage(about.photo.src) : null;
const facts = (about.facts ?? []).filter((f) => has(f?.label) && has(f?.value));
const ph = (v) => (isPlaceholder(v) ? 'ph' : undefined);
const quote = site.quote ?? {};
---
<Base nav={[{ label: 'work', href: '#work' }, { label: 'about', href: '#about' }, { label: 'contact', href: '#contact' }]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__stage">
      {areas.map((a) => <div class:list={['hero__field', `hero__field--${a.category}`]} aria-hidden="true"></div>)}
      <h1 class="hero__name" id="hero-title">{name.toLowerCase()}</h1>
    </div>
    <ul class="hero__index">
      {areas.map((a) => (
        <li class:list={['hero__area', `hero__area--${a.category}`]}>
          <a class="hero__word" href={`#${a.category}`}><T v={a.word} /></a>
          {a.projects.length > 0 && <ul class="hero__titles">{a.projects.map((p) => <li><a href={`/projects/${p.slug}/`}><T v={p.title} /></a></li>)}</ul>}
        </li>
      ))}
    </ul>
  </section>

  <section class:list={["letter wrap", { "letter--nophoto": !photo }]} id="about" {...(has(about.greeting) ? { "aria-labelledby": "about-title" } : { "aria-label": "About" })}>
    {photo && (
      <figure class="letter__photo tilt" style="--tilt:-0.6deg;--tilt-to:0.4deg">
        <Img meta={photo} alt={about.photo.alt ?? ''} sizes="(min-width: 960px) 36vw, 84vw" />
        {has(about.photo?.caption) && <figcaption><T v={about.photo.caption} /></figcaption>}
      </figure>
    )}
    <div class="letter__text">
      {has(about.greeting) && <h2 class="letter__title" id="about-title"><a href="/about/"><T v={about.greeting} /></a></h2>}
      {has(about.intro) && <p class="letter__intro"><T v={about.intro} /></p>}
      {facts.length > 0 && (
        <dl class="letter__facts">
          {facts.map((f) => (
            <div><dt>{f.label}</dt><dd><T v={f.value} /></dd></div>
          ))}
        </dl>
      )}
    </div>
  </section>

  {currently.length > 0 && (
    <section class="now wrap" {...(has(site.currently?.title) ? { "aria-labelledby": "now-title" } : { "aria-label": "Currently" })}>
      {has(site.currently?.title) && <h2 class="now__title" id="now-title"><T v={site.currently.title} /></h2>}
      {has(site.currently?.updated) && (
        <p class="now__updated">Updated <time datetime={site.currently.updated}>{formatDate(site.currently.updated)}</time></p>
      )}
      <ul class="now__list">
        {currently.map((item) => (
          <li class="now__row">
            <h3 class="now__item"><T v={item.title} /></h3>
            {has(item.text) && <p class="now__text"><T v={item.text} /></p>}
            {has(item.status) && <p class="now__status"><span class="marker"><T v={item.status} /></span></p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <Areas />

  {has(quote.text) && (
    <section class="quote wrap" aria-label={has(quote.label) ? quote.label : 'In short'}>
      {has(quote.label) && <p class="quote__label" aria-hidden="true"><T v={quote.label} /></p>}
      <blockquote class="quote__text"><p><T v={quote.text} /></p></blockquote>
    </section>
  )}

  <Closing slot="after" />
</Base>
