---
// Testseite für den Hero (Runde 25, dritter Versuch): "Arbeit im Feld".
// Jedes Farbfeld zeigt ein Projektbild seines Bereichs, in Graustufen und per Mischmodus in die Feldfarbe eingefärbt
// (helle Felder: multiply, dunkles Ink-Feld: screen). Zeigt man auf einen Projekttitel unter dem Hero, blendet das Feld
// auf dessen Bild über. Nur CSS-Deckkraft und -Transforms, kein Zeichnen pro Bild.
// Frühere Versuche (Partikel-Verlauf) abgelehnt, stehen in den Commits 8beada0 und c38676b.
// Nicht verlinkt, noindex, nicht in der Sitemap (Filter auf varianten/ in sitemap.xml.js).
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Img from '../../components/Img.astro';
import { site, has, CATEGORIES, byCategory, subtitleLinks } from '../../lib/content.js';
import { projectImages } from '../../lib/images.js';

const name = site.person?.name ?? '';
const words = subtitleLinks();
const areas = CATEGORIES.map((c, i) => {
  const projects = byCategory(c).filter((p) => has(p.title));
  // pro Projekt das erste echte Bild; Projekte ohne Bild (nur Platzhalter) ändern beim Zeigen nichts
  const imgs = projects.map((p) => ({ slug: p.slug, featured: !!p.featured, img: projectImages(p).find((x) => !x.placeholder) })).filter((x) => x.img);
  const def = (imgs.find((x) => x.featured) ?? imgs[0])?.slug;
  // Startbild zuerst (Reihenfolge für den automatischen Wechsel)
  imgs.sort((a, b) => (a.slug === def ? -1 : b.slug === def ? 1 : 0));
  return { i, category: c, word: words.find((w) => w.category === c)?.word ?? c, projects, imgs, def };
});
---
<Base title="Hero-Test" noindex nav={[{ label: 'work', href: '/#work' }, { label: 'about', href: '/#about' }, { label: 'contact', href: '/#contact' }]}>
  <section class="hero ht-s2 ht-intro-name ht-intro-img" aria-labelledby="hero-title">
    <div class="hero__stage">
      {areas.map((a) => (
        <div class:list={['hero__field', `hero__field--${a.category}`]} data-cat={a.category} data-order={a.imgs.map((x) => x.slug).join(' ')} style={`--i:${a.i}`} aria-hidden="true">
          <div class="hf">
            {a.imgs.map((x) => (
              <div class:list={['hf__img', { 'is-on': x.slug === a.def }]} data-slug={x.slug}>
                <Img meta={x.img.meta} alt="" sizes="(min-width: 960px) 40vw, 100vw" eager={x.slug === a.def} />
              </div>
            ))}
          </div>
        </div>
      ))}
      <h1 class="hero__name" id="hero-title">{name.toLowerCase()}</h1>
    </div>
    <ul class="hero__index">
      {areas.map((a) => (
        <li class:list={['hero__area', `hero__area--${a.category}`]} data-cat={a.category}>
          <a class="hero__word" href={`/#${a.category}`}><T v={a.word} /></a>
          {a.projects.length > 0 && <ul class="hero__titles">{a.projects.map((p) => <li><a href={`/projects/${p.slug}/`} data-slug={p.slug}><T v={p.title} /></a></li>)}</ul>}
        </li>
      ))}
    </ul>
  </section>

  <aside class="ht-panel" id="ht-panel" aria-label="Einstellungen">
    <div class="ht-head"><strong>Hero-Test 3: Arbeit im Feld</strong><span class="ht-keys">R nochmal · H aus</span></div>
    <p class="ht-note">Zeig mit der Maus auf einen Projekttitel unter dem Hero.</p>
    <div class="ht-grp"><span class="ht-lab">Bild</span><div class="ht-btns">
      <button type="button" data-k="s" data-v="1">zart</button><button type="button" data-k="s" data-v="2">mittel</button><button type="button" data-k="s" data-v="3">kräftig</button>
    </div></div>
    <div class="ht-grp"><span class="ht-lab">Fläche</span><div class="ht-btns">
      <button type="button" data-k="f" data-v="full">ganzes Feld</button><button type="button" data-k="f" data-v="frame">mit Rand</button>
    </div></div>
    <div class="ht-grp"><span class="ht-lab">Wechsel</span><div class="ht-btns">
      <button type="button" data-k="a" data-v="0">nur beim Zeigen</button><button type="button" data-k="a" data-v="1">auch von selbst</button>
    </div></div>
    <div class="ht-grp"><span class="ht-lab">Laden</span><div class="ht-btns">
      <button type="button" data-k="l" data-v="both">Name steigt auf + Bilder</button><button type="button" data-k="l" data-v="img">nur Bilder</button><button type="button" data-k="l" data-v="off">nichts</button>
    </div></div>
    <div class="ht-actions"><button type="button" id="ht-replay">Nochmal laden</button><button type="button" id="ht-hide">Ausblenden</button></div>
    <p class="ht-sum" id="ht-sum"></p>
  </aside>
  <button class="ht-show" id="ht-show" type="button" hidden>Einstellungen (H)</button>
</Base>

<style is:global>
  /* ---------- Bilder in den Feldern ---------- */
  .hero__field { position: relative; isolation: isolate; overflow: hidden; }
  .hf { position: absolute; inset: 0; mix-blend-mode: multiply; opacity: var(--o-light); }
  .hero__field--adventure .hf { mix-blend-mode: screen; opacity: var(--o-dark); }
  .hf__img { position: absolute; inset: 0; opacity: 0; transition: opacity 0.7s var(--ease); }
  .hf__img.is-on { opacity: 1; }
  .hf__img picture { display: block; width: 100%; height: 100%; }
  .hf__img img { display: block; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08); }
  /* Stärke: Deckkraft der eingefärbten Bilder (hell: multiply, dunkel: screen) */
  .ht-s1 { --o-light: 0.4; --o-dark: 0.2; }
  .ht-s2 { --o-light: 0.65; --o-dark: 0.32; }
  .ht-s3 { --o-light: 0.9; --o-dark: 0.48; }
  /* mit Rand: das Bild sitzt wie eine Tafel im Feld, der Name überlappt es unten */
  .ht-frame .hf { inset: calc(var(--margin) * 1.5) var(--margin) 0; }

  /* ---------- Laden ---------- */
  .ht-intro-name .hero__name { animation: hn-rise 1.1s cubic-bezier(0.2, 0.75, 0.1, 1) 0.1s backwards; }
  @keyframes hn-rise { from { transform: translateY(112%); } }
  .ht-intro-img .hf { animation: hf-in 1.6s cubic-bezier(0.25, 0.6, 0.2, 1) backwards; animation-delay: calc(0.45s + var(--i) * 0.15s); }
  @keyframes hf-in { from { opacity: 0; } }
  .ht-intro-img .hf__img.is-on img { animation: hf-zoom 2.4s cubic-bezier(0.2, 0.6, 0.2, 1) backwards; animation-delay: calc(0.45s + var(--i) * 0.15s); }
  @keyframes hf-zoom { from { transform: scale(1.08); } }
  @media (prefers-reduced-motion: reduce) {
    .hero__name, .hf, .hf__img img { animation: none !important; }
    .hf__img { transition-duration: 0.01s; }
  }

  /* ---------- Panel ---------- */
  .ht-panel, .ht-show { position: fixed; right: 16px; bottom: 16px; z-index: 50; font-size: 13px; line-height: 1.35; }
  .ht-panel { width: 400px; background: var(--ink); color: var(--ground); padding: 14px 16px 16px; box-shadow: 0 10px 40px rgb(18 6 46 / 0.3); }
  .ht-panel[hidden], .ht-show[hidden] { display: none; }
  .ht-show { background: var(--ink); color: var(--ground); border: 0; padding: 8px 12px; font-family: inherit; cursor: pointer; }
  .ht-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .ht-keys, .ht-note { opacity: 0.6; font-size: 11px; }
  .ht-note { margin-top: 4px; }
  .ht-grp { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 8px; align-items: start; margin-top: 8px; }
  .ht-lab { padding-top: 5px; opacity: 0.7; }
  .ht-btns { display: flex; flex-wrap: wrap; gap: 4px; }
  .ht-panel button { font: inherit; color: inherit; background: transparent; border: 1px solid color-mix(in srgb, var(--ground) 28%, transparent); padding: 4px 8px; cursor: pointer; transition: border-color 0.15s, background-color 0.15s; }
  .ht-panel button:hover { border-color: var(--ground); }
  .ht-panel button[aria-pressed='true'] { background: var(--lime); color: var(--ink); border-color: var(--lime); }
  .ht-actions { display: flex; gap: 6px; margin-top: 14px; }
  .ht-actions button { background: var(--ground); color: var(--ink); border-color: var(--ground); }
  .ht-sum { margin-top: 10px; font-size: 11px; opacity: 0.7; user-select: all; }
</style>

<script>
  const hero = document.querySelector('.hero');
  const panel = document.getElementById('ht-panel');
  const showBtn = document.getElementById('ht-show');
  const sumEl = document.getElementById('ht-sum');
  const fields = new Map([...document.querySelectorAll('.hero__field')].map((f) => [f.dataset.cat, f]));

  // ---------- Bild wechseln ----------
  const current = new Map(); // Bereich -> Projekt, das ohne Zeigen zu sehen ist
  const hovering = new Set();
  for (const [cat, f] of fields) current.set(cat, f.querySelector('.hf__img.is-on')?.dataset.slug);
  function show(cat, slug) {
    const f = fields.get(cat);
    const target = f && f.querySelector(`.hf__img[data-slug="${CSS.escape(slug ?? '')}"]`);
    if (!target) return;
    f.querySelectorAll('.hf__img.is-on').forEach((el) => { if (el !== target) el.classList.remove('is-on'); });
    target.classList.add('is-on');
  }
  for (const area of document.querySelectorAll('.hero__area')) {
    const cat = area.dataset.cat;
    for (const a of area.querySelectorAll('a[data-slug]')) {
      const on = () => { hovering.add(cat); show(cat, a.dataset.slug); };
      a.addEventListener('pointerenter', on);
      a.addEventListener('focus', on);
    }
    const off = () => { hovering.delete(cat); show(cat, current.get(cat)); };
    area.addEventListener('pointerleave', off);
    area.addEventListener('focusout', (e) => { if (!area.contains(e.relatedTarget)) off(); });
  }

  // ---------- Einstellungen ----------
  const state = { s: '2', f: 'full', a: '0', l: 'both' };
  for (const [k, v] of new URLSearchParams(location.hash.slice(1))) if (k in state) state[k] = v;
  let timers = [];
  function auto(on) {
    timers.forEach(clearInterval); timers.forEach(clearTimeout); timers = [];
    if (!on) return;
    [...fields.keys()].forEach((cat, i) => {
      const order = fields.get(cat).dataset.order.split(' ').filter(Boolean);
      if (order.length < 2) return;
      const step = () => {
        if (hovering.has(cat)) return;
        const next = order[(order.indexOf(current.get(cat)) + 1) % order.length];
        current.set(cat, next); show(cat, next);
      };
      timers.push(setTimeout(() => { step(); timers.push(setInterval(step, 6500)); }, 4000 + i * 2100));
    });
  }
  function intro() {
    hero.classList.remove('ht-intro-name', 'ht-intro-img');
    void hero.offsetWidth;
    if (state.l === 'both') hero.classList.add('ht-intro-name', 'ht-intro-img');
    if (state.l === 'img') hero.classList.add('ht-intro-img');
  }
  function apply() {
    hero.classList.remove('ht-s1', 'ht-s2', 'ht-s3');
    hero.classList.add(`ht-s${state.s}`);
    hero.classList.toggle('ht-frame', state.f === 'frame');
    panel.querySelectorAll('[data-k]').forEach((b) => b.setAttribute('aria-pressed', String(state[b.dataset.k] === b.dataset.v)));
    const label = (k) => panel.querySelector(`[data-k="${k}"][data-v="${state[k]}"]`)?.textContent ?? state[k];
    sumEl.textContent = `Bild: ${label('s')} · Fläche: ${label('f')} · Wechsel: ${label('a')} · Laden: ${label('l')}`;
    history.replaceState(null, '', `#${new URLSearchParams(state)}`);
  }
  panel.querySelectorAll('[data-k]').forEach((b) => b.addEventListener('click', () => {
    state[b.dataset.k] = b.dataset.v;
    apply();
    if (b.dataset.k === 'a') auto(state.a === '1');
    if (b.dataset.k === 'l') intro();
  }));
  const togglePanel = (on = panel.hidden) => { panel.hidden = !on; showBtn.hidden = on; };
  document.getElementById('ht-replay').addEventListener('click', intro);
  document.getElementById('ht-hide').addEventListener('click', () => togglePanel(false));
  showBtn.addEventListener('click', () => togglePanel(true));
  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'r' || e.key === 'R') intro();
    else if (e.key === 'h' || e.key === 'H') togglePanel();
  });
  apply();
  if (state.l !== 'both') intro();
  auto(state.a === '1');

  window.heroTest = {
    set: (o) => { Object.assign(state, o); apply(); auto(state.a === '1'); },
    show,
    panel: (on) => togglePanel(on),
    intro,
  };
</script>
