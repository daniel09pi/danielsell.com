---
// Testseite für den Hero (Runde 25): beige Partikel über den drei Farbflächen, oben dicht, nach unten weniger.
// So entsteht ein Verlauf von "transparent" (Beige wie die Navigation) zur vollen Farbe, ohne Farbverlauf.
// Nicht verlinkt, noindex, nicht in der Sitemap (Filter auf varianten/ in sitemap.xml.js).
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { site, has, CATEGORIES, byCategory, subtitleLinks } from '../../lib/content.js';

const name = site.person?.name ?? '';
const words = subtitleLinks();
const areas = CATEGORIES.map((c) => ({
  category: c,
  word: words.find((w) => w.category === c)?.word ?? c,
  projects: byCategory(c).filter((p) => has(p.title)),
}));
---
<Base title="Hero-Test" noindex nav={[{ label: 'work', href: '/#work' }, { label: 'about', href: '/#about' }, { label: 'contact', href: '/#contact' }]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__stage">
      {areas.map((a) => <div class:list={['hero__field', `hero__field--${a.category}`]} aria-hidden="true"></div>)}
      <canvas class="ht-dust" aria-hidden="true"></canvas>
      <h1 class="hero__name" id="hero-title">{name.toLowerCase()}</h1>
    </div>
    <ul class="hero__index">
      {areas.map((a) => (
        <li class:list={['hero__area', `hero__area--${a.category}`]}>
          <a class="hero__word" href={`/#${a.category}`}><T v={a.word} /></a>
          {a.projects.length > 0 && <ul class="hero__titles">{a.projects.map((p) => <li><a href={`/projects/${p.slug}/`}><T v={p.title} /></a></li>)}</ul>}
        </li>
      ))}
    </ul>
  </section>
  <aside class="ht-panel" id="ht-panel" aria-label="Einstellungen"></aside>
  <button class="ht-show" id="ht-show" type="button" hidden>Regler (H)</button>
</Base>

<style is:global>
  .hero__stage { position: relative; }
  .ht-dust { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .ht-under .site-nav { position: relative; z-index: 3; }

  .ht-panel, .ht-show { position: fixed; right: 16px; bottom: 16px; z-index: 50; font-size: 13px; line-height: 1.35; }
  .ht-panel { width: 350px; max-height: calc(100vh - 32px); overflow: auto; background: var(--ink); color: var(--ground); padding: 14px 16px 16px; box-shadow: 0 10px 40px rgb(18 6 46 / 0.3); }
  .ht-panel[hidden], .ht-show[hidden] { display: none; }
  .ht-show { background: var(--ink); color: var(--ground); border: 0; padding: 8px 12px; font-family: inherit; cursor: pointer; }
  .ht-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 10px; }
  .ht-keys { opacity: 0.6; font-size: 11px; }
  .ht-presets { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; }
  .ht-preset { font: inherit; color: inherit; background: transparent; border: 1px solid color-mix(in srgb, var(--ground) 28%, transparent); padding: 5px 8px; text-align: left; cursor: pointer; transition: border-color 0.15s, background-color 0.15s; }
  .ht-preset:hover { border-color: var(--ground); }
  .ht-preset[aria-pressed='true'] { background: var(--lime); color: var(--ink); border-color: var(--lime); }
  .ht-group { margin-top: 14px; font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; opacity: 0.55; }
  .ht-row { display: grid; grid-template-columns: 118px minmax(0, 1fr) 48px; align-items: center; gap: 8px; margin-top: 6px; }
  .ht-row output { text-align: right; opacity: 0.75; font-variant-numeric: tabular-nums; }
  .ht-row input[type='range'] { width: 100%; accent-color: var(--lime); margin: 0; }
  .ht-row select { grid-column: 2 / -1; width: 100%; font: inherit; background: var(--ground); color: var(--ink); border: 0; padding: 3px 6px; }
  .ht-row--check input { justify-self: start; accent-color: var(--lime); margin: 0; }
  .ht-hint { margin-top: 4px; font-size: 11px; opacity: 0.6; }
  .ht-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 14px; }
  .ht-actions button { font: inherit; background: var(--ground); color: var(--ink); border: 0; padding: 6px 10px; cursor: pointer; }
  .ht-actions button:hover { background: var(--lime); }
  .ht-sum { margin-top: 10px; font-size: 11px; opacity: 0.7; user-select: all; }
</style>

<script>
  // Zeichnet beige Rechtecke (Farbe der Navigation/des Grundes) über die drei Farbflächen.
  // Dichte d(y): oben "Dichte oben", ab "Ganz beige bis" fallend, bei "Letzte Partikel bei" null.
  // Ein Partikel erscheint, wenn sein Schwellwert (Muster) kleiner als d ist: so entsteht der Verlauf aus der Anzahl.
  const stage = document.querySelector('.hero__stage');
  const canvas = document.querySelector('.ht-dust');
  const nameEl = document.querySelector('.hero__name');
  const panel = document.getElementById('ht-panel');
  const showBtn = document.getElementById('ht-show');
  const ctx = canvas.getContext('2d');
  const GROUND = getComputedStyle(document.documentElement).getPropertyValue('--ground').trim() || '#f5f2eb';

  const DEFAULTS = { pattern: 'bayer', cell: 10, aspect: 1, gap: 0, start: 0, end: 0.6, curve: 1, top: 1, anim: 'none', speed: 1, mouse: 'reveal', radius: 140, intro: 1, under: 0 };
  const PRESETS = [
    { name: 'Raster', p: { pattern: 'bayer', cell: 10, aspect: 1, gap: 0, start: 0, end: 0.6, curve: 1, top: 1, anim: 'none', speed: 1, mouse: 'reveal', radius: 140 } },
    { name: 'Rauschen', p: { pattern: 'ign', cell: 6, aspect: 1, gap: 0, start: 0, end: 0.62, curve: 1.4, top: 1, anim: 'twinkle', speed: 0.6, mouse: 'trail', radius: 120 } },
    { name: 'Regen', p: { pattern: 'white', cell: 4, aspect: 0.33, gap: 1, start: 0.02, end: 0.72, curve: 1.6, top: 1, anim: 'flow', speed: 2.5, mouse: 'repel', radius: 160 } },
    { name: 'Striche', p: { pattern: 'ign', cell: 6, aspect: 4, gap: 2, start: 0, end: 0.6, curve: 1.2, top: 1, anim: 'none', speed: 1, mouse: 'repel', radius: 180 } },
    { name: 'Mosaik', p: { pattern: 'mosaic', cell: 8, aspect: 1, gap: 0, start: 0, end: 0.62, curve: 1.1, top: 1, anim: 'flow', speed: 0.35, mouse: 'reveal', radius: 150 } },
    { name: 'Halbton', p: { pattern: 'halftone', cell: 18, aspect: 1, gap: 0, start: 0, end: 0.6, curve: 1, top: 1, anim: 'flow', speed: 0.5, mouse: 'repel', radius: 170 } },
    { name: 'Grob', p: { pattern: 'bayer', cell: 30, aspect: 1, gap: 0, start: 0, end: 0.5, curve: 1, top: 1, anim: 'none', speed: 1, mouse: 'trail', radius: 140 } },
    { name: 'Staub', p: { pattern: 'white', cell: 3, aspect: 1, gap: 0, start: 0, end: 0.8, curve: 2.4, top: 1, anim: 'twinkle', speed: 1, mouse: 'repel', radius: 200 } },
  ];
  const pct = (v) => `${Math.round(v * 100)} %`;
  const CONTROLS = [
    { group: 'Partikel' },
    { k: 'pattern', label: 'Muster', opts: [['bayer', 'Raster, geordnet'], ['ign', 'Rauschen, gleichmäßig'], ['white', 'Zufall'], ['mosaic', 'Mosaik: groß zu klein'], ['halftone', 'Halbton: Größe statt Anzahl']] },
    { k: 'cell', label: 'Größe', min: 2, max: 48, step: 1, f: (v) => `${v} px` },
    { k: 'aspect', label: 'Form (B : H)', opts: [[0.25, '1 : 4, hoch'], [0.33, '1 : 3'], [0.5, '1 : 2'], [1, '1 : 1, Quadrat'], [2, '2 : 1'], [3, '3 : 1'], [4, '4 : 1'], [6, '6 : 1, breit']] },
    { k: 'gap', label: 'Lücke', min: 0, max: 6, step: 1, f: (v) => `${v} px` },
    { group: 'Verlauf' },
    { k: 'top', label: 'Dichte oben', min: 0.3, max: 1, step: 0.01, f: pct },
    { k: 'start', label: 'Ganz dicht bis', min: 0, max: 0.8, step: 0.01, f: pct },
    { k: 'end', label: 'Letzte bei', min: 0.1, max: 1, step: 0.01, f: pct },
    { k: 'curve', label: 'Kurve', min: 0.3, max: 4, step: 0.1, f: (v) => v.toFixed(1) },
    { hint: 'name' },
    { group: 'Bewegung' },
    { k: 'anim', label: 'Animation', opts: [['none', 'keine'], ['twinkle', 'flimmern'], ['flow', 'rieseln (nach unten)']] },
    { k: 'speed', label: 'Tempo', min: 0.1, max: 4, step: 0.1, f: (v) => v.toFixed(1) },
    { k: 'intro', label: 'Intro beim Laden', check: true },
    { group: 'Maus' },
    { k: 'mouse', label: 'Maus', opts: [['none', 'nichts'], ['reveal', 'legt Farbe frei'], ['cloud', 'zieht Beige mit'], ['repel', 'schiebt Partikel weg'], ['trail', 'Spur, wächst nach']] },
    { k: 'radius', label: 'Radius', min: 40, max: 400, step: 10, f: (v) => `${v} px` },
    { group: 'Layout' },
    { k: 'under', label: 'Bis unter die Navi', check: true },
  ];

  let P = { ...DEFAULTS, ...PRESETS[0].p };
  let current = 0;
  if (location.hash.length > 1) {
    const q = new URLSearchParams(location.hash.slice(1));
    for (const [k, v] of q) if (k in DEFAULTS) P[k] = typeof DEFAULTS[k] === 'number' ? Number(v) : v;
    current = -1;
  }

  // ---------- Muster ----------
  const BAYER = [0, 32, 8, 40, 2, 34, 10, 42, 48, 16, 56, 24, 50, 18, 58, 26, 12, 44, 4, 36, 14, 46, 6, 38, 60, 28, 52, 20, 62, 30, 54, 22,
    3, 35, 11, 43, 1, 33, 9, 41, 51, 19, 59, 27, 49, 17, 57, 25, 15, 47, 7, 39, 13, 45, 5, 37, 63, 31, 55, 23, 61, 29, 53, 21];
  const frac = (x) => x - Math.floor(x);
  function hash(i, j, k) {
    let h = (Math.imul(i, 374761393) + Math.imul(j, 668265263) + Math.imul(k, 2246822519)) | 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    h ^= h >>> 16;
    return (h >>> 0) / 4294967296;
  }
  function base(i, j) {
    if (P.pattern === 'bayer') return (BAYER[((j & 7) << 3) | (i & 7)] + 0.5) / 64;
    if (P.pattern === 'ign') return frac(52.9829189 * frac(0.06711056 * i + 0.00583715 * j));
    return hash(i, j, 0);
  }
  let time = 0;
  function thr(i, j, lvl) {
    let b = lvl ? hash(i, j, lvl) : base(i, j);
    if (P.anim === 'twinkle') b = frac(b + time * P.speed * (P.pattern === 'bayer' ? 0.2 : 0.12 + 0.3 * hash(i, j, 99)));
    return b;
  }

  // ---------- Größe, Maus, Spur ----------
  let W = 1, H = 1, dpr = 1, nameTop = 0.55;
  const TS = 6; // Rastergröße der Spur in CSS-px
  let tw = 1, th = 1, field = new Float32Array(1), fieldActive = false;

  function applyUnder() {
    stage.style.marginTop = '';
    stage.style.height = '';
    document.body.classList.toggle('ht-under', !!P.under);
    if (P.under) {
      const nh = document.querySelector('.site-nav').getBoundingClientRect().height;
      const h = stage.getBoundingClientRect().height;
      stage.style.marginTop = `${-nh}px`;
      stage.style.height = `${h + nh}px`;
    }
  }
  function resize() {
    applyUnder();
    const r = canvas.getBoundingClientRect();
    dpr = Math.min(2, window.devicePixelRatio || 1);
    W = Math.max(1, Math.round(r.width * dpr));
    H = Math.max(1, Math.round(r.height * dpr));
    canvas.width = W;
    canvas.height = H;
    const ts = TS * dpr;
    tw = Math.ceil(W / ts); th = Math.ceil(H / ts);
    field = new Float32Array(tw * th); fieldActive = false;
    // Oberkante der Oberlängen (d, l): Grundlinie (Unterkante des Namens) minus 0,734 em
    const nr = nameEl.getBoundingClientRect();
    const fs = parseFloat(getComputedStyle(nameEl).fontSize);
    nameTop = (nr.bottom - 0.734 * fs - r.top) / r.height;
    updateHint();
  }

  let mx = -1e5, my = -1e5, sx = -1e5, sy = -1e5, lx = null, ly = null;
  function stamp(x, y) {
    const R = P.radius * dpr, ts = TS * dpr, R2 = R * R;
    const i0 = Math.max(0, Math.floor((x - R) / ts)), i1 = Math.min(tw - 1, Math.floor((x + R) / ts));
    const j0 = Math.max(0, Math.floor((y - R) / ts)), j1 = Math.min(th - 1, Math.floor((y + R) / ts));
    for (let j = j0; j <= j1; j++) {
      const dy = (j + 0.5) * ts - y;
      for (let i = i0; i <= i1; i++) {
        const dx = (i + 0.5) * ts - x, q = (dx * dx + dy * dy) / R2;
        if (q < 1) { const v = (1 - q) * (1 - q), k = j * tw + i; if (v > field[k]) field[k] = v; }
      }
    }
    fieldActive = true;
  }
  addEventListener('pointermove', (e) => {
    const r = canvas.getBoundingClientRect();
    const x = (e.clientX - r.left) * dpr, y = (e.clientY - r.top) * dpr;
    if (sx < -1e4) { sx = x; sy = y; }
    mx = x; my = y;
    if (P.mouse === 'trail') {
      const x0 = lx ?? x, y0 = ly ?? y;
      const n = Math.max(1, Math.ceil(Math.hypot(x - x0, y - y0) / (P.radius * dpr * 0.2)));
      for (let s = 1; s <= n; s++) stamp(x0 + ((x - x0) * s) / n, y0 + ((y - y0) * s) / n);
    }
    lx = x; ly = y;
  }, { passive: true });
  document.documentElement.addEventListener('pointerleave', () => { mx = my = sx = sy = -1e5; lx = ly = null; });

  // ---------- Zeichnen ----------
  let S = 0, E = 1, TOP = 1, R = 1, R2 = 1, gapPx = 0, mode = 'none';
  function dens(y) {
    const u = (y / H - S) / Math.max(1e-4, E - S);
    if (u <= 0) return TOP;
    if (u >= 1) return 0;
    return TOP * Math.pow(1 - u, P.curve);
  }
  function local(d, x, y) {
    if (mode === 'reveal' || mode === 'cloud') {
      const dx = x - sx, dy = y - sy, q = (dx * dx + dy * dy) / R2;
      if (q < 1) { const f = (1 - q) * (1 - q); d = mode === 'reveal' ? d * (1 - f) : d + (1 - d) * f * 0.85; }
    } else if (mode === 'trail' && fieldActive) {
      const ts = TS * dpr, i = (x / ts) | 0, j = (y / ts) | 0;
      if (i >= 0 && i < tw && j >= 0 && j < th) d *= 1 - field[j * tw + i];
    }
    return d;
  }
  // d: Dichte an der Stelle. Die Lücke wächst erst, wenn die Dichte sinkt, damit oben alles zu Beige verschmilzt.
  function addRect(x, y, w, h, d) {
    if (mode === 'repel') {
      const dx = x + w / 2 - sx, dy = y + h / 2 - sy, d2 = dx * dx + dy * dy;
      if (d2 < R2 && d2 > 0.01) { const dd = Math.sqrt(d2), q = 1 - dd / R, m = (q * q * R * 0.5) / dd; x += dx * m; y += dy * m; }
    }
    const g = (gapPx / 2) * Math.min(1, (1 - d) * 5);
    const x0 = Math.round(x + g), y0 = Math.round(y + g), x1 = Math.round(x + w - g), y1 = Math.round(y + h - g);
    if (x1 > x0 && y1 > y0) ctx.rect(x0, y0, x1 - x0, y1 - y0);
  }
  function drawGrid(cw, ch, off, yLimit) {
    const cols = Math.ceil(W / cw);
    const j0 = Math.floor(-off / ch) - 1, j1 = Math.ceil((yLimit - off) / ch);
    const half = P.pattern === 'halftone';
    for (let j = j0; j <= j1; j++) {
      const y = j * ch + off;
      if (y + ch < 0) continue;
      if (y > yLimit) break;
      const yc = y + ch / 2, dr = dens(yc);
      if (dr <= 0 && mode !== 'cloud') continue;
      for (let i = 0; i < cols; i++) {
        const x = i * cw, xc = x + cw / 2;
        let d = local(dr, xc, yc);
        if (d <= 0.002) continue;
        if (half) {
          if (P.anim === 'twinkle') d *= 0.7 + 0.3 * Math.sin(6.2832 * (time * P.speed * 0.4 + hash(i, j, 7)));
          const s = Math.sqrt(Math.min(1, d)), w = cw * s, h = ch * s;
          if (w >= 1) addRect(xc - w / 2, yc - h / 2, w, h, d);
        } else if (thr(i, j, 0) < d) addRect(x, y, cw, ch, d);
      }
    }
  }
  // Mosaik: Blöcke aus 4 × 4 Zellen; oben ganze Blöcke, nach unten teilen sie sich in Rechtecke (4×2, 2×2, 2×1, 1×1).
  // Pacc hält die Wahrscheinlichkeit, dass ein größerer Block schon gezeichnet wurde, damit die Dichte im Mittel stimmt.
  function node(li, lj, wl, hl, lvl, Pacc, cw, ch, off, yLimit) {
    const x = li * cw, y = lj * ch + off, w = wl * cw, h = hl * ch;
    if (y > yLimit || y + h < 0) return;
    const d = local(dens(y + h / 2), x + w / 2, y + h / 2);
    const de = Pacc > 0 ? (d - Pacc) / (1 - Pacc) : d;
    if (wl === 1 && hl === 1) { if (de > 0 && thr(li, lj, lvl) < de) addRect(x, y, w, h, d); return; }
    const p = de > 0 ? de * de * de : 0;
    if (p > 0 && thr(li, lj, lvl) < p) { addRect(x, y, w, h, d); return; }
    if (mode !== 'cloud' && dens(y) <= 0) return;
    const Pn = 1 - (1 - Pacc) * (1 - p);
    if (hl >= wl) { const hh = hl / 2; node(li, lj, wl, hh, lvl + 1, Pn, cw, ch, off, yLimit); node(li, lj + hh, wl, hh, lvl + 1, Pn, cw, ch, off, yLimit); }
    else { const hw = wl / 2; node(li, lj, hw, hl, lvl + 1, Pn, cw, ch, off, yLimit); node(li + hw, lj, hw, hl, lvl + 1, Pn, cw, ch, off, yLimit); }
  }
  function drawMosaic(cw, ch, off, yLimit) {
    const B = 4, bh = ch * B, cols = Math.ceil(W / (cw * B));
    const r0 = Math.floor(-off / bh) - 1, r1 = Math.ceil((yLimit - off) / bh);
    for (let r = r0; r <= r1; r++) for (let c = 0; c < cols; c++) node(c * B, r * B, B, B, 1, 0, cw, ch, off, yLimit);
  }

  const ease = (k) => (k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);
  const lerp = (a, b, t) => a + (b - a) * t;
  let last = performance.now(), introStart = P.intro ? last : null, flowOff = 0;
  function frame(now) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    time += dt;
    if (P.anim === 'flow') flowOff += dt * P.speed * 30 * dpr;
    let e = 1;
    if (introStart !== null) {
      const k = Math.min(1, (now - introStart) / 1800);
      e = ease(k);
      if (k >= 1) introStart = null;
    }
    S = lerp(1, P.start, e); E = lerp(1.25, P.end, e); TOP = lerp(1, P.top, e);
    mode = P.mouse; R = P.radius * dpr; R2 = R * R; gapPx = P.gap * dpr;
    const sm = 1 - Math.exp(-dt * 12);
    sx += (mx - sx) * sm; sy += (my - sy) * sm;
    if (Math.abs(mx) > 1e4) { sx = mx; sy = my; }
    if (fieldActive) {
      const k = Math.exp(-dt * 0.6 * P.speed);
      let any = false;
      for (let i = 0; i < field.length; i++) { const v = field[i] * k; field[i] = v > 0.004 ? v : 0; if (v > 0.004) any = true; }
      fieldActive = any;
    }

    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = GROUND;
    ctx.beginPath();
    const c = P.cell * dpr, a = P.aspect;
    const cw = a >= 1 ? c * a : c, ch = a >= 1 ? c : c / a;
    const yLimit = mode === 'cloud' ? H : Math.min(H, E * H + ch);
    if (P.pattern === 'mosaic') drawMosaic(cw, ch, flowOff, yLimit);
    else drawGrid(cw, ch, flowOff, yLimit);
    ctx.fill();
    requestAnimationFrame(frame);
  }

  // ---------- Panel ----------
  const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
  const outputs = {}, inputs = {};
  let presetBtns = [], hintEl = null, sumEl = null;
  function fmt(c) {
    const v = P[c.k];
    if (c.opts) return (c.opts.find((o) => String(o[0]) === String(v)) ?? [v, String(v)])[1];
    if (c.check) return v ? 'an' : 'aus';
    return c.f(v);
  }
  function summary() {
    const head = current >= 0 ? `Variante ${current + 1} ${PRESETS[current].name} · ` : '';
    return head + CONTROLS.filter((c) => c.k).map((c) => `${c.label}: ${fmt(c)}`).join(' · ');
  }
  function updateHint() { if (hintEl) hintEl.textContent = `Der Name beginnt bei ${pct(nameTop)} der Fläche.`; }
  function sync() {
    for (const c of CONTROLS) {
      if (!c.k) continue;
      const inp = inputs[c.k];
      if (c.check) inp.checked = !!P[c.k];
      else inp.value = String(P[c.k]);
      if (outputs[c.k]) outputs[c.k].textContent = fmt(c);
    }
    presetBtns.forEach((b, i) => b.setAttribute('aria-pressed', String(i === current)));
    if (sumEl) sumEl.textContent = summary();
    history.replaceState(null, '', `#${new URLSearchParams(Object.entries(P).map(([k, v]) => [k, String(v)]))}`);
  }
  function set(k, v) {
    const before = P.under;
    P[k] = v;
    if (k === 'mouse') { field.fill(0); fieldActive = false; }
    if (k === 'under' && before !== v) resize();
  }
  function usePreset(i) {
    const keepUnder = P.under, keepIntro = P.intro;
    P = { ...DEFAULTS, ...PRESETS[i].p, under: keepUnder, intro: keepIntro };
    current = i;
    field.fill(0); fieldActive = false;
    sync();
  }
  function togglePanel(show = panel.hidden) { panel.hidden = !show; showBtn.hidden = show; }
  function buildPanel() {
    const head = el('div', 'ht-head');
    head.append(el('strong', '', 'Hero-Test'), el('span', 'ht-keys', '1–8 Varianten · I Intro · H ausblenden'));
    const presets = el('div', 'ht-presets');
    presetBtns = PRESETS.map((pr, i) => {
      const b = el('button', 'ht-preset', `${i + 1}  ${pr.name}`);
      b.type = 'button';
      b.addEventListener('click', () => usePreset(i));
      presets.append(b);
      return b;
    });
    panel.append(head, presets);
    for (const c of CONTROLS) {
      if (c.group) { panel.append(el('div', 'ht-group', c.group)); continue; }
      if (c.hint) { hintEl = el('p', 'ht-hint'); panel.append(hintEl); continue; }
      const row = el('div', c.check ? 'ht-row ht-row--check' : 'ht-row');
      const id = `ht-${c.k}`;
      const lab = el('label', '', c.label); lab.htmlFor = id;
      let inp;
      if (c.opts) {
        inp = el('select');
        for (const [v, t] of c.opts) { const o = el('option', '', t); o.value = String(v); inp.append(o); }
        inp.addEventListener('change', () => { set(c.k, typeof DEFAULTS[c.k] === 'number' ? Number(inp.value) : inp.value); current = -1; sync(); });
        row.append(lab, inp);
      } else if (c.check) {
        inp = el('input'); inp.type = 'checkbox';
        inp.addEventListener('change', () => { set(c.k, inp.checked ? 1 : 0); sync(); });
        row.append(lab, inp);
      } else {
        inp = el('input'); inp.type = 'range'; inp.min = c.min; inp.max = c.max; inp.step = c.step;
        inp.addEventListener('input', () => { set(c.k, Number(inp.value)); current = -1; sync(); });
        const out = el('output'); outputs[c.k] = out;
        row.append(lab, inp, out);
      }
      inp.id = id;
      inputs[c.k] = inp;
      panel.append(row);
    }
    const actions = el('div', 'ht-actions');
    const bIntro = el('button', '', 'Intro abspielen'); bIntro.type = 'button';
    bIntro.addEventListener('click', () => { introStart = performance.now(); });
    const bCopy = el('button', '', 'Werte kopieren'); bCopy.type = 'button';
    bCopy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(`${summary()}\n${location.href}`); bCopy.textContent = 'Kopiert'; }
      catch { bCopy.textContent = 'Bitte unten markieren'; }
      setTimeout(() => { bCopy.textContent = 'Werte kopieren'; }, 1600);
    });
    const bHide = el('button', '', 'Ausblenden'); bHide.type = 'button';
    bHide.addEventListener('click', () => togglePanel(false));
    actions.append(bIntro, bCopy, bHide);
    sumEl = el('p', 'ht-sum');
    panel.append(actions, sumEl);
  }
  showBtn.addEventListener('click', () => togglePanel(true));
  addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLSelectElement || e.metaKey || e.ctrlKey || e.altKey) return;
    const n = Number(e.key);
    if (n >= 1 && n <= PRESETS.length) usePreset(n - 1);
    else if (e.key === 'h' || e.key === 'H') togglePanel();
    else if (e.key === 'i' || e.key === 'I') introStart = performance.now();
  });

  buildPanel();
  sync();
  resize();
  new ResizeObserver(() => resize()).observe(document.querySelector('.hero'));
  document.fonts?.ready.then(resize);
  requestAnimationFrame(frame);

  // Für Screenshots: heroTest.preset(2), heroTest.set({ cell: 12 }), heroTest.panel(false)
  window.heroTest = {
    preset: (i) => usePreset(i),
    set: (o) => { for (const [k, v] of Object.entries(o)) set(k, v); current = -1; sync(); },
    panel: (show) => togglePanel(show),
    intro: () => { introStart = performance.now(); },
  };
</script>
