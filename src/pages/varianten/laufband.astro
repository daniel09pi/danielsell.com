---
// Testseite für den Hero: "Laufband". Ein Band aus Projektbildern läuft endlos von rechts nach links quer über die
// drei Felder. Über jedem Feld zeigt jede Kachel ein Bild aus dessen Bereich; an den Feldkanten ist eine Kachel
// geteilt (links das Bild des einen, rechts das des anderen Bereichs).
// Umsetzung: drei deckungsgleiche Ebenen (eine pro Bereich) mit identischer Geometrie und derselben Animation,
// jede auf ihre Spalte zugeschnitten (clip-path). Bewegung nur per transform (Web Animations), kein Zeichnen pro Bild.
// Nicht verlinkt, noindex, nicht in der Sitemap (Filter auf varianten/ in sitemap.xml.js).
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { site, has, isPlaceholder, CATEGORIES, byCategory, subtitleLinks } from '../../lib/content.js';
import { resolveImage } from '../../lib/images.js';

const name = site.person?.name ?? '';
const words = subtitleLinks();
const areas = CATEGORIES.map((c) => ({ category: c, word: words.find((w) => w.category === c)?.word ?? c, projects: byCategory(c).filter((p) => has(p.title)) }));

// Bilder pro Bereich. Ein Bild, das schon in einem früheren Bereich vorkommt (flowinsync zeigt vorläufig Bilder
// aus creative), gehört dem ersten Bereich; sonst stünde ein creative-Bild über dem dev-Feld.
const owner = new Map();
const pools = {};
for (const c of CATEGORIES) {
  pools[c] = areas.find((a) => a.category === c).projects.map((p) => {
    const imgs = (p.images ?? [])
      .map((e) => (typeof e === 'string' ? e : e?.src))
      .filter((src) => has(src) && !isPlaceholder(src))
      .filter((src) => { if (owner.has(src) && owner.get(src) !== c) return false; owner.set(src, c); return true; })
      .map((src) => {
        const m = resolveImage(src);
        return { srcset: m.variants.avif.map((v) => `${encodeURI(v.url)} ${v.w}w`).join(', '), src: encodeURI(m.variants.avif[0].url) };
      });
    return { slug: p.slug, title: p.title, imgs };
  }).filter((p) => p.imgs.length);
}
---
