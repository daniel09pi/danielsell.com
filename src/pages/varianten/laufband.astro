---
// Testseite für den Hero: "Laufband". Ein Band aus Projektbildern läuft endlos quer über die drei Felder. Über jedem
// Feld zeigt jede Kachel ein Bild aus dessen Bereich; an den Feldkanten ist eine Kachel geteilt (links das Bild des
// einen, rechts das des anderen Bereichs).
// Umsetzung: drei deckungsgleiche Ebenen (eine pro Bereich) mit identischer Geometrie und derselben Animation, jede per
// overflow: clip auf ihre Spalte zugeschnitten. Bewegung nur per transform (Web Animations), Stehenbleiben beim
// Scrollen per position: sticky. Alle Werte stehen in CONFIG im Skript unten.
// Nicht verlinkt, noindex, nicht in der Sitemap (Filter auf varianten/ in sitemap.xml.js).
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { site, has, isPlaceholder, CATEGORIES, byCategory, subtitleLinks } from '../../lib/content.js';
import { resolveImage } from '../../lib/images.js';

const name = site.person?.name ?? '';
const words = subtitleLinks();
const areas = CATEGORIES.map((c) => ({ category: c, word: words.find((w) => w.category === c)?.word ?? c, projects: byCategory(c).filter((p) => has(p.title)) }));

// Bilder pro Bereich. Ein Bild, das schon in einem früheren Bereich vorkommt (flowinsync zeigt vorläufig Bilder
// aus creative), gehört dem ersten Bereich; sonst stünde ein creative-Bild über dem dev-Feld.
const owner = new Map();
const pools = {};
for (const c of CATEGORIES) {
  pools[c] = areas.find((a) => a.category === c).projects.map((p) => {
    const imgs = (p.images ?? [])
      .map((e) => (typeof e === 'string' ? e : e?.src))
      .filter((src) => has(src) && !isPlaceholder(src))
      .filter((src) => { if (owner.has(src) && owner.get(src) !== c) return false; owner.set(src, c); return true; })
      .map((src) => {
        const m = resolveImage(src);
        return { srcset: m.variants.avif.map((v) => `${encodeURI(v.url)} ${v.w}w`).join(', '), src: encodeURI(m.variants.avif[0].url) };
      });
    return { slug: p.slug, imgs };
  }).filter((p) => p.imgs.length);
}
---
<Base title="Laufband-Test" noindex nav={[{ label: 'work', href: '/#work' }, { label: 'about', href: '/#about' }, { label: 'contact', href: '/#contact' }]}>
  {/* Ladeanimation: nur einmal pro Besuch (Tab), nicht bei reduzierter Bewegung, ohne JS gar nicht. Steht vor dem Hero und
      läuft sofort, damit nichts erst sichtbar ist und dann verschwindet. ?intro in der Adresse erzwingt sie. */}
  <script is:inline>
    (function () {
      try {
        var force = /[?&]intro/.test(location.search);
        if (!force && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!force && sessionStorage.getItem('ds-intro')) return;
        sessionStorage.setItem('ds-intro', '1');
        document.documentElement.classList.add('intro');
      } catch (e) {}
    })();
  </script>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__stage" id="lb-stage">
      {areas.map((a) => <div class:list={['hero__field', `hero__field--${a.category}`]} aria-hidden="true"></div>)}
      <div class="lb" id="lb" aria-hidden="true"></div>
      <h1 class="hero__name" id="hero-title">{name.toLowerCase()}</h1>
    </div>
    <ul class="hero__index">
      {areas.map((a) => (
        <li class:list={['hero__area', `hero__area--${a.category}`]}>
          <a class="hero__word" href={`/#${a.category}`}><T v={a.word} /></a>
          {a.projects.length > 0 && <ul class="hero__titles">{a.projects.map((p) => <li><a href={`/projects/${p.slug}/`}><T v={p.title} /></a></li>)}</ul>}
        </li>
      ))}
    </ul>
  </section>
  <div class="lb-spacer" aria-hidden="true"></div>
  <script type="application/json" id="lb-data" set:html={JSON.stringify(pools)}></script>
</Base>

<style is:global>
  /* clip statt hidden: kein Scroll-Container, sonst bezöge sich sticky (unten) auf die Bühne statt aufs Fenster */
  #lb-stage { position: relative; overflow: clip; }
  html.lenis { scroll-behavior: auto; }
  /* Der Name reagiert nicht auf die Maus: kein Textcursor, nicht markierbar */
  #lb-stage .hero__name { pointer-events: none; user-select: none; -webkit-user-select: none; }
  .lb-spacer { height: 160vh; } /* nur zum Ausprobieren des Scrollens */

  /* ---------- Ladeanimation: alles kommt aus der Linie unter dem Namen (ca. 1,2 s) ----------
     1. die Linie zeichnet sich von links nach rechts, 2. die Felder wachsen aus ihr nach oben (leicht versetzt, der
     Linie folgend), 3. der Name steigt aus der Linie auf (die Bühne schneidet unten ab), 4. das Band blendet ein und
     läuft an (Tempo im Skript), dazu das Register darunter. Nur transform und opacity. */
  html.intro .hero__stage { border-bottom-color: transparent; }
  html.intro .hero__index { position: relative; }
  html.intro .hero__index::before {
    content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: var(--line);
    transform-origin: left; animation: in-line 0.45s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  html.intro .hero__field { transform-origin: bottom; animation: in-field 0.6s cubic-bezier(0.2, 0.75, 0.1, 1) both; }
  html.intro .hero__field--creative { animation-delay: 0.18s; }
  html.intro .hero__field--adventure { animation-delay: 0.25s; }
  html.intro .hero__field--dev { animation-delay: 0.32s; }
  html.intro .hero__name { animation: in-name 0.7s cubic-bezier(0.2, 0.75, 0.1, 1) 0.42s both; }
  html.intro .lb { animation: in-fade 0.5s ease 0.7s both; }
  html.intro .hero__area { animation: in-fade 0.5s ease both; }
  html.intro .hero__area--creative { animation-delay: 0.75s; }
  html.intro .hero__area--adventure { animation-delay: 0.82s; }
  html.intro .hero__area--dev { animation-delay: 0.89s; }
  @keyframes in-line { from { transform: scaleX(0); } }
  @keyframes in-field { from { transform: scaleY(0); } }
  @keyframes in-name { from { transform: translateY(102%); } }
  @keyframes in-fade { from { opacity: 0; } }

  /* ---------- Laufband ---------- */
  .lb { position: absolute; inset: 0; pointer-events: none; }
  /* Eine Ebene pro Bereich, per overflow: clip auf ihre Spalte zugeschnitten; innen liegt das Band wieder bühnenbreit
     und um die Spalte nach links versetzt (--k), damit alle drei Ebenen deckungsgleich sind. */
  .lb__layer { position: absolute; top: 0; bottom: 0; width: 33.3333%; overflow: clip; }
  .lb__layer[data-cat='creative'] { left: 0; --k: 0; }
  .lb__layer[data-cat='adventure'] { left: 33.3333%; --k: 1; }
  .lb__layer[data-cat='dev'] { left: 66.6667%; --k: 2; }
  /* Stehenbleiben: der Anker (.lb__stick) klebt an seiner Startposition im Fenster (--stick-top); sein Behälter
     (.lb__pin) reicht weit genug nach unten. Die Bühne schneidet ab, also verschwindet das Band hinter Name und Grund. */
  .lb__pin { position: absolute; top: 0; left: calc(var(--k) * -100%); width: 300%; height: calc(100% + var(--pin-end, 0px)); }
  .lb__stick { position: sticky; top: var(--stick-top); margin-top: var(--y); height: 0; }
  /* Band: breiter als die Bühne, damit es gekippt bis an die Ränder reicht */
  .lb__band { position: absolute; left: -25%; width: 150%; top: 0; transform: translateY(-50%) rotate(var(--tilt)); display: flex; flex-direction: column; gap: var(--g); }
  .lb__track { display: flex; width: max-content; will-change: transform; }
  .lb__tile { flex: none; width: var(--w); height: var(--h); margin-right: var(--g); overflow: hidden; }
  .lb__tile img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.06); transition: filter 0.6s var(--ease); }
  /* Die Spalte, über deren Farbfeld die Maus ist, zeigt ihre Bilder in Farbe */
  .lb[data-col='creative'] .lb__layer[data-cat='creative'] img,
  .lb[data-col='adventure'] .lb__layer[data-cat='adventure'] img,
  .lb[data-col='dev'] .lb__layer[data-cat='dev'] img { filter: none; }
</style>

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  // ---------- Einstellungen ----------
  const CONFIG = {
    speed: 64,          // px pro Sekunde
    direction: 1,       // 1 = nach rechts, -1 = nach links
    height: 160,        // Höhe eines Bilds in px
    aspect: 4 / 5,      // Breite : Höhe
    gap: 5,             // Abstand zwischen den Bildern und den Reihen in px
    rows: 2,            // Reihen (laufen gleich)
    position: 0.33,     // Mitte des Bands in Anteilen der Höhe des Farbfelds
    tilt: -9,           // Neigung des ganzen Bands in Grad
    fadeOnScroll: true, // Bilder werden beim Runterscrollen schwächer
    smoothScroll: 0.1,  // Lenis lerp (kleiner = weicher), 0 = normales Scrollen
  };

  type Img = { srcset: string; src: string };
  type Proj = { slug: string; imgs: Img[] };
  const pools: Record<string, Proj[]> = JSON.parse(document.getElementById('lb-data')!.textContent!);
  const CATS = ['creative', 'adventure', 'dev'];
  const stage = document.getElementById('lb-stage')!;
  const lb = document.getElementById('lb')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const intro = document.documentElement.classList.contains('intro');
  const INTRO = { bandStart: 700, bandRamp: 900, end: 1700 }; // ms seit Seitenaufruf: Band läuft an, bis volles Tempo, Ende

  // Projekte im Wechsel: erst je das erste Bild jedes Projekts, dann je das zweite …
  function sequence(cat: string): Img[] {
    const projs = pools[cat];
    const out: Img[] = [];
    const max = Math.max(0, ...projs.map((p) => p.imgs.length));
    for (let n = 0; n < max; n++) for (const p of projs) if (p.imgs[n]) out.push(p.imgs[n]);
    return out;
  }

  // ---------- Band bauen ----------
  let anims: Animation[] = [];
  function build() {
    anims.forEach((a) => a.cancel());
    anims = [];
    lb.textContent = '';
    const { height: h, gap: g } = CONFIG;
    const w = Math.round(h * CONFIG.aspect);
    const step = w + g;
    let n = Math.max(2, Math.ceil((stage.clientWidth * 1.5) / step));
    if (n % 2) n++;
    const loop = n * step;
    lb.style.setProperty('--w', `${w}px`);
    lb.style.setProperty('--h', `${h}px`);
    lb.style.setProperty('--g', `${g}px`);
    lb.style.setProperty('--tilt', `${CONFIG.tilt}deg`);
    const duration = (loop / CONFIG.speed) * 1000;
    const frames = CONFIG.direction > 0
      ? [{ transform: `translateX(${-loop}px)` }, { transform: 'translateX(0)' }]
      : [{ transform: 'translateX(0)' }, { transform: `translateX(${-loop}px)` }];

    for (const cat of CATS) {
      const seq = sequence(cat);
      const layer = document.createElement('div');
      layer.className = 'lb__layer';
      layer.dataset.cat = cat;
      const pin = document.createElement('div');
      pin.className = 'lb__pin';
      const stick = document.createElement('div');
      stick.className = 'lb__stick';
      const band = document.createElement('div');
      band.className = 'lb__band';
      for (let r = 0; r < CONFIG.rows; r++) {
        const track = document.createElement('div');
        track.className = 'lb__track';
        for (let i = 0; i < n * 2; i++) {
          const tile = document.createElement('div');
          tile.className = 'lb__tile';
          const item = seq.length ? seq[((i % n) + r * 3) % seq.length] : null; // zweite Reihe beginnt mit anderen Bildern
          if (item) {
            const img = document.createElement('img');
            img.alt = '';
            img.decoding = 'async';
            img.sizes = `${w}px`;
            img.srcset = item.srcset;
            img.src = item.src;
            tile.append(img);
          }
          track.append(tile);
        }
        band.append(track);
        const anim = track.animate(frames, { duration, iterations: Infinity, easing: 'linear' });
        (anim as any)._row = r;
        anims.push(anim);
      }
      stick.append(band);
      pin.append(stick);
      layer.append(pin);
      lb.append(layer);
    }
    // Alle Ebenen auf exakt dieselbe Zeit (sonst stimmen die geteilten Kacheln nicht überein); jede weitere Reihe um
    // eine halbe Kachel versetzt
    const t0 = (anims[0]?.currentTime as number) ?? 0;
    for (const a of anims) a.currentTime = t0 + (((a as any)._row * duration) * (step / 2)) / loop;
    if (reduce) anims.forEach((a) => a.pause());
    else if (intro && !rampDone) rampIn();
    place();
  }

  // Ladeanimation: das Band steht zuerst und läuft dann wie eine Maschine an (0 → volles Tempo, weich).
  // Nur während dieser knappen Sekunde ein paar Frames, danach nichts mehr pro Frame.
  let rampDone = false;
  function rampIn() {
    anims.forEach((a) => { a.playbackRate = 0; });
    const tick = () => {
      const t = Math.min(1, Math.max(0, (performance.now() - INTRO.bandStart) / INTRO.bandRamp));
      const e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      anims.forEach((a) => { a.playbackRate = e; });
      if (t < 1) requestAnimationFrame(tick); else rampDone = true;
    };
    requestAnimationFrame(tick);
  }
  if (intro) setTimeout(() => document.documentElement.classList.remove('intro'), Math.max(0, INTRO.end - performance.now()));

  // ---------- Lage, Stehenbleiben, Ausblenden ----------
  function place() {
    const top = stage.getBoundingClientRect().top + scrollY;
    const y = stage.offsetHeight * CONFIG.position;
    lb.style.setProperty('--y', `${y}px`);
    lb.style.setProperty('--stick-top', `${top + y}px`);
    lb.style.setProperty('--pin-end', `${Math.round(top + stage.offsetHeight)}px`);
    fade();
  }
  // Deckkraft nach 1 − t²: anfangs kaum, gegen Ende schneller; 0 erst, wenn das gekippte Band ganz hinter der
  // Unterkante der Bühne verschwunden ist. Direkt auf den drei .lb__pin, damit nicht alle Kacheln neu rechnen.
  function fade() {
    if (!CONFIG.fadeOnScroll) return;
    const pins = lb.querySelectorAll<HTMLElement>('.lb__pin');
    const stickTop = parseFloat(lb.style.getPropertyValue('--stick-top')) || 0;
    const r = stage.getBoundingClientRect();
    const band = lb.querySelector<HTMLElement>('.lb__band');
    const a = (Math.abs(CONFIG.tilt) * Math.PI) / 180;
    const half = band ? (band.offsetHeight * Math.cos(a) + r.width * Math.sin(a)) / 2 : 0;
    const range = r.bottom + scrollY - stickTop + half;
    const t = Math.min(1, Math.max(0, scrollY / Math.max(1, range)));
    const o = String(Math.round((1 - t * t) * 1000) / 1000);
    pins.forEach((p) => { p.style.opacity = o; });
  }

  // ---------- Farbe unter der Maus ----------
  // Nur über den Feldern (bis zur Linie unter dem Namen), nach x-Position (Drittel); sonst alles schwarzweiß.
  const setCol = (c: string | null) => { if (c) lb.dataset.col = c; else delete lb.dataset.col; };
  let px = -1, py = -1;
  function checkCol() {
    const r = stage.getBoundingClientRect();
    const inside = px >= r.left && px < r.right && py >= r.top && py < r.bottom;
    setCol(inside ? CATS[Math.min(2, Math.floor(((px - r.left) / r.width) * 3))] : null);
  }
  addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; checkCol(); }, { passive: true });
  document.documentElement.addEventListener('pointerleave', () => { px = py = -1; checkCol(); });

  // Beim Scrollen höchstens einmal pro Frame: Ausblenden und (die Bühne wandert unter der Maus weg) Farbe
  let raf = 0;
  addEventListener('scroll', () => {
    if (raf) return;
    raf = requestAnimationFrame(() => { raf = 0; fade(); if (px >= 0) checkCol(); });
  }, { passive: true });

  // ---------- Weiches Scrollen (Lenis, im Bundle) ----------
  if (CONFIG.smoothScroll > 0 && !reduce) new Lenis({ autoRaf: true, lerp: CONFIG.smoothScroll, anchors: true });

  let rz = 0;
  let lastW = stage.clientWidth;
  addEventListener('resize', () => {
    clearTimeout(rz);
    rz = window.setTimeout(() => { if (stage.clientWidth !== lastW) { lastW = stage.clientWidth; build(); } else place(); }, 200);
  });
  build();
</script>
