---
// Testseite (noindex, nicht verlinkt, nicht in der Sitemap): Die drei Farbfelder des Heros gehen nach oben
// ineinander und in die Navigation über. Kein glatter CSS-Verlauf (der zeigt auf vielen Bildschirmen Stufen),
// sondern einmal pro Größe pixelgenau gerechnet, mit Korn. Kein Animations-Loop: neu gerechnet wird nur bei Größenänderung.
// Varianten: 1 Korn (weicher Verlauf + feines Filmkorn), 2 Streuung (jedes Pixel ist eine der vier Markenfarben,
// keine Mischtöne), 3 Fasern (Verlauf läuft in senkrechten Fasern nach oben aus, mit Korn). Tasten 1–3, H blendet das Panel aus.
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { site, has, CATEGORIES, byCategory, subtitleLinks } from '../../lib/content.js';

const name = site.person?.name ?? '';
const words = subtitleLinks();
const areas = CATEGORIES.map((c) => ({
  category: c,
  word: words.find((w) => w.category === c)?.word ?? c,
  projects: byCategory(c).filter((p) => has(p.title)),
}));
---
<Base title="Verlauf-Test" noindex nav={[{ label: 'work', href: '/#work' }, { label: 'about', href: '/#about' }, { label: 'contact', href: '/#contact' }]}>
  <section class="hero gx" aria-labelledby="hero-title">
    <div class="hero__stage">
      {areas.map((a) => <div class:list={['hero__field', `hero__field--${a.category}`]} aria-hidden="true"></div>)}
      <canvas class="gx__canvas" aria-hidden="true"></canvas>
      <h1 class="hero__name" id="hero-title">{name.toLowerCase()}</h1>
    </div>
    <ul class="hero__index">
      {areas.map((a) => (
        <li class:list={['hero__area', `hero__area--${a.category}`]}>
          <a class="hero__word" href={`/#${a.category}`}><T v={a.word} /></a>
          {a.projects.length > 0 && <ul class="hero__titles">{a.projects.map((p) => <li><a href={`/projects/${p.slug}/`}><T v={p.title} /></a></li>)}</ul>}
        </li>
      ))}
    </ul>
  </section>

  <form class="gx-panel" aria-label="Varianten">
    <fieldset>
      <legend>Variante</legend>
      <label><input type="radio" name="v" value="korn" /> 1 Korn</label>
      <label><input type="radio" name="v" value="streu" /> 2 Streuung</label>
      <label><input type="radio" name="v" value="faser" checked /> 3 Fasern</label>
    </fieldset>
    <fieldset>
      <legend>Korn</legend>
      <label><input type="radio" name="g" value="0.5" /> fein</label>
      <label><input type="radio" name="g" value="1" checked /> mittel</label>
      <label><input type="radio" name="g" value="1.8" /> kräftig</label>
    </fieldset>
    <fieldset>
      <legend>Korn auf den vollen Flächen</legend>
      <label><input type="radio" name="f" value="0" /> nein</label>
      <label><input type="radio" name="f" value="1" checked /> ja</label>
    </fieldset>
    <fieldset>
      <legend>Übergang</legend>
      <label><input type="radio" name="m" value="2" checked /> Blur, Licht</label>
      <label><input type="radio" name="m" value="3" /> Blur, OKLab</label>
      <label><input type="radio" name="m" value="1" /> alt (Bogen)</label>
      <label><input type="radio" name="m" value="0" /> nicht mischen</label>
    </fieldset>
    <fieldset>
      <legend>Blur beginnt</legend>
      <label><input type="radio" name="b" value="oben" /> über dem Namen</label>
      <label><input type="radio" name="b" value="name" /> hinter dem Namen</label>
      <label><input type="radio" name="b" value="all" checked /> ganzer Hintergrund weich</label>
    </fieldset>
    <fieldset>
      <legend>Mitte (Ink) ausgleichen</legend>
      <label><input type="radio" name="w" value="0" /> nein</label>
            <label><input type="radio" name="w" value="0.8" /> 0,8</label>
      <label><input type="radio" name="w" value="1.1" /> 1,1</label>
      <label><input type="radio" name="w" value="1.5" /> 1,5</label>
      <label><input type="radio" name="w" value="1.9" checked /> 1,9</label>
      <label><input type="radio" name="w" value="2.4" /> 2,4</label>
    </fieldset>
    <fieldset>
      <legend>Schrift läuft in Fasern aus</legend>
      <label><input type="radio" name="s" value="0" checked /> nein</label>
      <label><input type="radio" name="s" value="1" /> ja</label>
    </fieldset>
    <fieldset>
      <legend>Verlauf</legend>
      <label><input type="radio" name="h" value="0.75" /> kurz</label>
      <label><input type="radio" name="h" value="1" /> mittel</label>
      <label><input type="radio" name="h" value="1.3" checked /> lang</label>
    </fieldset>
    <p class="gx-panel__hint">Tasten 1–3 · H Panel</p>
  </form>
</Base>

<style is:global>
  /* Navigation liegt über dem oberen Ende des Verlaufs */
  body:has(.gx) { --nav-h: 5.25rem; }
  body:has(.gx) .site-nav { position: relative; z-index: 2; }
  .gx { margin-top: calc(-1 * var(--nav-h)); }
  .gx .hero__stage {
    position: relative;
    height: calc(var(--nav-h) + max(calc(var(--name-ascent) * var(--name-size) + (var(--name-lines) - 1) * 0.84 * var(--name-size) + clamp(3rem, 12vh, 9rem)),
                calc(100svh - 5.25rem - var(--index-h, 15rem))));
  }
  /* Ohne JavaScript: ein einfacher CSS-Verlauf als Rückfall */
  .gx .hero__field { -webkit-mask: linear-gradient(to top, #000 50%, transparent 92%); mask: linear-gradient(to top, #000 50%, transparent 92%); }
  .gx__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 0.6s var(--ease); }
  .gx__canvas.is-ready { opacity: 1; }

  .gx-panel {
    position: fixed; right: 16px; bottom: 16px; z-index: 10;
    display: grid; gap: 0.6rem; padding: 0.9rem 1rem;
    background: var(--ground); color: var(--ink); border: 1px solid var(--line);
    font-size: 0.8125rem; line-height: 1.3; max-width: 17rem;
  }
  .gx-panel fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.15rem 0.75rem; }
  .gx-panel legend { padding: 0; margin-bottom: 0.2rem; color: var(--ink-soft); width: 100%; }
  .gx-panel label { display: inline-flex; gap: 0.3rem; align-items: center; cursor: pointer; }
  .gx-panel input { accent-color: var(--accent); margin: 0; }
  .gx-panel__hint { color: var(--ink-soft); margin: 0; }
  .gx-panel[hidden] { display: none; }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.gx .hero__stage')!;
  const canvas = stage.querySelector<HTMLCanvasElement>('.gx__canvas')!;
  const nameEl = stage.querySelector<HTMLElement>('.hero__name')!;
  const form = document.querySelector<HTMLFormElement>('.gx-panel')!;
  // Der Hero liegt genau unter der Navigation: echte Höhe messen statt schätzen (sonst bleibt oben ein Streifen)
  const setNav = () => document.body.style.setProperty('--nav-h', document.querySelector<HTMLElement>('.site-nav')!.offsetHeight + 'px');
  setNav(); window.addEventListener('resize', setNav);

  // ---- Farben: sRGB → linear → OKLab (gemischt wird in OKLab, damit Übergänge nicht grau/matschig werden)
  const toLin = (c: number) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
  function oklab([r, g, b]: number[]) {
    const [R, G, B] = [toLin(r), toLin(g), toLin(b)];
    const l = Math.cbrt(0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B);
    const m = Math.cbrt(0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B);
    const s = Math.cbrt(0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B);
    return [
      0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
      1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,
      0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s,
    ];
  }
  // linear → sRGB 0..255 über eine Tabelle (schnell genug für jedes Pixel)
  const LUT = new Float32Array(4097);
  for (let i = 0; i <= 4096; i++) { const c = i / 4096; LUT[i] = 255 * (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055); }
  const enc = (c: number) => LUT[c <= 0 ? 0 : c >= 1 ? 4096 : (c * 4096) | 0];

  const css = getComputedStyle(document.documentElement);
  const v = (n: string) => css.getPropertyValue(n).trim();
  const HEX = { ground: v('--ground'), c0: v('--lime'), c1: v('--ink'), c2: v('--accent') };
  const RGB = Object.fromEntries(Object.entries(HEX).map(([k, h]) => [k, hex(h).map((x) => x * 255)])) as Record<string, number[]>;
  const LAB = Object.fromEntries(Object.entries(HEX).map(([k, h]) => [k, oklab(hex(h))])) as Record<string, number[]>;

  // ---- Zufall: fester Startwert, damit das Bild bei gleicher Größe gleich aussieht
  function rng(seed: number) { return () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
  // 1D-Rauschen für die Fasern: mehrere Oktaven geglätteter Zufallswerte
  function fibers(W: number, scale: number) {
    const out = new Float32Array(W); const r = rng(7);
    for (const [len, amp] of [[220, 0.5], [60, 0.3], [14, 0.14], [4, 0.06]] as const) {
      const L = Math.max(2, len * scale), n = Math.ceil(W / L) + 2, pts = Array.from({ length: n }, () => r() * 2 - 1);
      for (let x = 0; x < W; x++) { const p = x / L, i = p | 0, t = p - i, s = t * t * (3 - 2 * t); out[x] += amp * (pts[i] * (1 - s) + pts[i + 1] * s); }
    }
    return out;
  }

  // Verteilungsfunktion der Normalverteilung (Abramowitz/Stegun 7.1.26), für den exakten Gauß-Blur der Streifenkanten
  function Phi(z: number) {
    const x = Math.abs(z) / Math.SQRT2, k = 1 / (1 + 0.3275911 * x);
    const e = 1 - ((((1.061405429 * k - 1.453152027) * k + 1.421413741) * k - 0.284496736) * k + 0.254829592) * k * Math.exp(-x * x);
    return z >= 0 ? 0.5 * (1 + e) : 0.5 * (1 - e);
  }
  const ss = (a: number, b: number, x: number) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };

  function state() {
    const fd = new FormData(form);
    return { v: String(fd.get('v')), g: +fd.get('g')!, f: fd.get('f') === '1', h: +fd.get('h')!, m: +fd.get('m')!, b: String(fd.get('b')), s: fd.get('s') === '1', w: +fd.get('w')! };
  }

  function paint() {
    const { v: variant, g: grain, f: grainFull, h: reach, m: mode, b: blurStart, s: nameFibers, w: inkComp } = state();
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const box = stage.getBoundingClientRect();
    const W = Math.round(box.width * dpr), H = Math.round(box.height * dpr);
    if (!W || !H) return;
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext('2d')!;
    const img = ctx.createImageData(W, H), px = img.data;

    // Wo der Name beginnt: darunter bleiben die Flächen voll. Oberkante der Großbuchstaben ≈ Grundlinie − 0,74 em.
    const nb = nameEl.getBoundingClientRect(), fs = parseFloat(getComputedStyle(nameEl).fontSize);
    const solidY = (nb.bottom - box.top - fs * 0.86) * dpr;          // ab hier abwärts volle Farbe
    const topY = Math.max(0, solidY - solidY * 0.92 * reach);         // ab hier aufwärts nur Beige
    const span = Math.max(1, solidY - topY);
    const fib = variant === 'faser' ? fibers(W, dpr) : null;
    const rand = rng(1234);
    const G = LAB.ground, C = [LAB.c0, LAB.c1, LAB.c2];
    const P = [RGB.c0, RGB.c1, RGB.c2, RGB.ground];
    const amp = 9 * grain;
    // Blur-Modus: die drei Streifen enden oben bei yEnd und werden mit einem Gaußschen Blur verwischt, dessen Radius
    // über eine Maske wächst (an der Oberkante des Namens 0, oben am stärksten). Gerechnet exakt (Fehlerfunktion), nicht gefiltert.
    const blurMode = mode >= 2, linear = mode === 2;
    const sigMax = 0.14 * W;
    const x1 = W / 3, x2 = (2 * W) / 3;
    const LIN = [RGB.c0, RGB.c1, RGB.c2, RGB.ground].map((c) => c.map((v) => toLin(v / 255)));
    // Wo der Blur anfängt: über dem Namen (spitz, alt), hinter dem Namen ab der Grundlinie (sanft), oder überall mit Grundunschärfe
    const baseY = (nb.bottom - box.top) * dpr;
    const y0 = blurStart === 'all' ? H : baseY;
    const sigFloor = blurStart === 'all' ? 0.045 * W : 0;
    const span0 = Math.max(1, y0 - topY);

    // Schrift in Fasern: Name unsichtbar nachzeichnen, pro Spalte die oberste Kante finden und von dort beige Fasern nach oben ziehen.
    // Der echte Text (h1) bleibt darüber und scharf; der Canvas malt nur die Fasern über den Buchstaben.
    let trail: Float32Array | null = null;
    if (nameFibers) {
      const off = document.createElement('canvas'); off.width = W; off.height = H;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      const cs = getComputedStyle(nameEl);
      o.font = `${cs.fontWeight} ${fs * dpr}px ${cs.fontFamily}`;
      (o as any).letterSpacing = `${parseFloat(cs.letterSpacing) * dpr}px`;
      o.textBaseline = 'alphabetic';
      o.fillText(nameEl.textContent!.trim(), (nb.left - box.left + parseFloat(cs.paddingLeft)) * dpr, baseY);
      const a = o.getImageData(0, 0, W, H).data;
      trail = new Float32Array(W * H);
      const nf = fibers(W, dpr * 0.35), r = rng(99), L0 = 0.32 * fs * dpr;
      for (let x = 0; x < W; x++) {
        let top = -1;
        for (let y = 0; y < H; y++) if (a[(y * W + x) * 4 + 3] > 8) { top = y; break; }
        if (top < 0) continue;
        const L = L0 * (0.2 + 0.8 * Math.min(1, Math.max(0, 0.5 + 0.6 * nf[x]))) * (0.65 + 0.7 * r());
        // ein paar Pixel in den Buchstaben hinein beginnen (dort deckt der echte Text), damit keine Kante zwischen Text und Faser bleibt
        for (let y = Math.min(H - 1, top + 3 * dpr); y >= 0; y--) { const v = 0.92 * Math.exp(-Math.max(0, top - y) / L); if (v < 0.004) break; trail[y * W + x] = v; }
      }
    }

    for (let y = 0; y < H; y++) {
      // t: 0 an der vollen Fläche, 1 oben im Beige
      const t0 = 1 - (y - topY) / span;
      for (let x = 0; x < W; x++) {
        const shift = fib ? fib[x] * 0.16 * span * ss(-0.1, 0.6, t0) * (1 - ss(0.85, 1.3, t0)) : 0;
        const yy = y - shift;                                           // y, um die Fasern verschoben
        const t = Math.min(1, Math.max(0, 1 - (yy - topY) / span));
        // Seiten verschmelzen zuerst (unterer Teil des Verlaufs), dann blasst alles zu Beige aus (oberer Teil)
        let k0: number, k1: number, k2: number, fade: number;
        if (blurMode) {
          // Maske für den Blur-Radius: oben stark, unten schwach
          const tb = Math.min(1, Math.max(0, (y0 - yy) / span0));
          const sig = blurStart === 'oben' ? sigMax * Math.pow(t, 0.6) : sigFloor + (sigMax - sigFloor) * Math.pow(tb, 1.4);
          if (sig < 0.3) { k0 = x < x1 ? 1 : 0; k2 = x >= x2 ? 1 : 0; }
          else {
            // Ausgleich: Bei Licht-Mischung überstrahlen Limette und Violett das dunkle Ink, die Mitte wirkt schmaler als ein Drittel.
            // Die Kanten des Ink-Streifens rücken deshalb um einen Teil des Blur-Radius nach außen (nur im Blur, die Mitte bleibt auf den Dritteln).
            const off = linear ? inkComp * sig : 0;
            k0 = Phi((x1 - off - x) / sig); k2 = Phi((x - x2 - off) / sig);
          }
          k1 = 1 - k0 - k2;
          const yEnd = solidY - 0.62 * span;                            // hier enden die Streifen, der Blur macht daraus den Übergang ins Beige
          fade = sig < 0.3 ? 0 : 1 - Phi((yy - yEnd) / Math.max(sig, 1));
        } else {
          const blend = mode === 1 ? ss(0.0, 0.75, t) * 0.2 : 0;        // halbe Breite der Übergangszone; 0 = jede Spalte läuft für sich aus
          const u = x / W;
          const w1 = blend > 0 ? ss(-blend, blend, u - 1 / 3) : (u >= 1 / 3 ? 1 : 0);
          const w2 = blend > 0 ? ss(-blend, blend, u - 2 / 3) : (u >= 2 / 3 ? 1 : 0);
          k0 = 1 - w1; k1 = w1 - w2; k2 = w2;
          fade = ss(0.2, 1, t);                                         // Anteil Beige
        }
        if (trail) { const tr = trail[y * W + x]; if (tr) fade += (1 - fade) * tr; }
        const i = (y * W + x) * 4;

        if (variant === 'streu') {
          // Jedes Pixel ist genau eine Markenfarbe; die Wahrscheinlichkeit folgt dem Verlauf.
          let r = rand(), c: number[];
          if (r < fade) c = P[3];
          else { const q = rand(); c = q < k0 ? P[0] : q < k0 + k1 ? P[1] : P[2]; }
          px[i] = c[0]; px[i + 1] = c[1]; px[i + 2] = c[2]; px[i + 3] = 255;
          continue;
        }

        let R: number, Gc: number, Bc: number;
        if (linear) {
          // Mischung wie echtes Licht (linear): helle Farben setzen sich durch, das dunkle Ink frisst nicht seitlich
          const q = 1 - fade;
          R = enc((k0 * LIN[0][0] + k1 * LIN[1][0] + k2 * LIN[2][0]) * q + LIN[3][0] * fade);
          Gc = enc((k0 * LIN[0][1] + k1 * LIN[1][1] + k2 * LIN[2][1]) * q + LIN[3][1] * fade);
          Bc = enc((k0 * LIN[0][2] + k1 * LIN[1][2] + k2 * LIN[2][2]) * q + LIN[3][2] * fade);
        } else {
        // Mischung in OKLab
        const L = (k0 * C[0][0] + k1 * C[1][0] + k2 * C[2][0]) * (1 - fade) + G[0] * fade;
        const A = (k0 * C[0][1] + k1 * C[1][1] + k2 * C[2][1]) * (1 - fade) + G[1] * fade;
        const B = (k0 * C[0][2] + k1 * C[1][2] + k2 * C[2][2]) * (1 - fade) + G[2] * fade;
        let l = L + 0.3963377774 * A + 0.2158037573 * B, m = L - 0.1055613458 * A - 0.0638541728 * B, s = L - 0.0894841775 * A - 1.291485548 * B;
        l *= l * l; m *= m * m; s *= s * s;
        R = enc(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s);
        Gc = enc(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s);
        Bc = enc(-0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s);
        }
        // Korn: einfarbig (gleich auf allen Kanälen), dreieckverteilt. Am stärksten mitten im Verlauf,
        // oben im Beige fast keins, auf den vollen Flächen nur, wenn eingeschaltet.
        const where = grainFull ? 0.55 + 0.45 * Math.sin(Math.PI * Math.min(1, t * 1.15)) : Math.sin(Math.PI * Math.min(1, t * 1.15)) ** 0.7;
        const n = (rand() + rand() - 1) * amp * where + (rand() - 0.5);   // + halbe Stufe Dither gegen Stufen
        px[i] = R + n; px[i + 1] = Gc + n; px[i + 2] = Bc + n; px[i + 3] = 255;
      }
    }
    ctx.putImageData(img, 0, 0);
    canvas.classList.add('is-ready');
  }

  // Zustand in der Adresse (#v=faser&g=1&f=1&h=1.3&m=0), damit Daniel Links auf eine Fassung schicken kann
  function readHash() {
    const p = new URLSearchParams(location.hash.slice(1));
    for (const k of ['v', 'g', 'f', 'h', 'm', 'b', 's', 'w']) { const val = p.get(k); const el = val && form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${val}"]`); if (el) el.checked = true; }
  }
  function writeHash() { history.replaceState(null, '', '#' + new URLSearchParams(Object.entries(Object.fromEntries(new FormData(form))) as [string, string][]).toString()); }

  readHash();
  form.addEventListener('change', () => { writeHash(); paint(); });
  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement && e.key === ' ') return;
    const map: Record<string, string> = { '1': 'korn', '2': 'streu', '3': 'faser' };
    if (map[e.key]) { form.querySelector<HTMLInputElement>(`input[name="v"][value="${map[e.key]}"]`)!.checked = true; writeHash(); paint(); }
    if (e.key === 'h' || e.key === 'H') form.hidden = !form.hidden;
  });
  let timer = 0, lastW = 0, lastH = 0;
  new ResizeObserver(([e]) => {
    const { width, height } = e.contentRect;
    if (Math.round(width) === lastW && Math.round(height) === lastH) return;
    lastW = Math.round(width); lastH = Math.round(height);
    clearTimeout(timer); timer = window.setTimeout(paint, 120);
  }).observe(stage);
  document.fonts.ready.then(paint);
</script>
